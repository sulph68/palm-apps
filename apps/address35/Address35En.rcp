/* ---- Date value dialog (Birthday / Anniversary): any-year entry -------- *
 * Resource holds the Anniversary layout (Type on line 1). For a Birthday the
 * Type row is hidden and the Date/Year/Unknown rows are shifted up one line by
 * EditDateDialog, so a Birthday starts at line 1 with no gap. The year field
 * base-aligns with the "Year" label; the Unknown checkbox aligns under the
 * year field. */
FORM ID frmDateDlg AT (2 50 156 108) MODAL
	MENUID mnuDlgEdit
BEGIN
	TITLE "Birthday"
	/* line 1: Type (Anniversary only). Labels bold, at popup_y+1 so their
	 * baseline lines up with the popup/field text; controls share x=34. */
	LABEL "Type:"			ID lblDateType	AT (6 21) FONT 1
	POPUPTRIGGER "Wedding"	ID popDateType	AT (54 20 75 13) LEFTANCHOR
	LIST "Engagement" "Remembrance" "Wedding" "Work" "Other" ID lstDateType AT (54 20 75 66) VISIBLEITEMS 5 NONUSABLE
	POPUPLIST				ID popDateType lstDateType
	/* custom type name, shown beside a shrunk popup only when Type = "Other" */
	FIELD	ID fldDateTypeOther	AT (111 20 42 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 30 NONUSABLE
	/* Month / Day / Year each on its own row: ONE push-button holding the whole
	 * value (not per-digit) + an up/down REPEATBUTTON pair that continuously
	 * wraps the value while held (see EditDialogs.c DateBump). Real positions
	 * are set by DateLayout; RCP AT() here is just a fallback/initial size. */
	LABEL "Month:"			ID lblDateDate	AT (6 39) FONT 1
	PUSHBUTTON "12"			ID pbDateMonthVal	AT (99 38 24 14)
	REPEATBUTTON "\x01"		ID btnDateMonthUp	AT (131 36 13 8) NOFRAME FONT 5
	REPEATBUTTON "\x02"		ID btnDateMonthDn	AT (131 44 13 8) NOFRAME FONT 5
	LABEL "Day:"			ID lblDateDay	AT (6 57) FONT 1
	PUSHBUTTON "31"			ID pbDateDayVal		AT (99 56 24 14)
	REPEATBUTTON "\x01"		ID btnDateDayUp		AT (131 54 13 8) NOFRAME FONT 5
	REPEATBUTTON "\x02"		ID btnDateDayDn		AT (131 62 13 8) NOFRAME FONT 5
	LABEL "Year:"			ID lblDateYear	AT (6 75) FONT 1
	PUSHBUTTON "2026"		ID pbDateYearVal	AT (84 74 38 14)
	REPEATBUTTON "\x01"		ID btnDateYearUp	AT (131 72 13 8) NOFRAME FONT 5
	REPEATBUTTON "\x02"		ID btnDateYearDn	AT (131 80 13 8) NOFRAME FONT 5
	/* Unknown-year checkbox on its own row (box + label). */
	CHECKBOX ""			ID cbDateNoYear	AT (44 93 12 12)
	LABEL "Unknown"			ID lblDateUnknown	AT (58 94)
	BUTTON "OK"			ID btnDateOK		AT (6 110 40 12)
	BUTTON "Cancel"		ID btnDateCancel	AT (52 110 44 12)
	GRAFFITISTATEINDICATOR					AT (142 112)
END

