#include "AddressRsc.h"

BITMAP ID bmpCardFolder "folder.bmp"
BITMAP ID bmpCardUp "cardup.bmp"

ICON "icons/icon35_large.bmp"
SMALLICON "icons/icon35_small.bmp"
VERSION ID 1 "1.0"

/* ---- Main (list) form -------------------------------------------------- */
FORM ID frmMain AT (0 0 160 160)
	MENUID mnuMain
BEGIN
	TITLE "Address35"
	POPUPTRIGGER ""			ID popMainCategory  AT (90 0 70 13) RIGHTANCHOR
	LIST ""					ID lstMainCategory  AT (89 1 71 1)
							VISIBLEITEMS 1 NONUSABLE
	POPUPLIST				ID popMainCategory lstMainCategory
	TABLE					ID tblMainList		AT (0 16 152 128) ROWS 11 COLUMNS 1
							COLUMNWIDTHS 152
	SCROLLBAR				ID sclMainScroll	AT (153 16 7 128)
							VALUE 0 MIN 0 MAX 0 PAGESIZE 11
	BUTTON "New"			ID btnMainNew		AT (1 146 26 12)
	/* Find bar: [New] __field__ [Cancel].  Filters live as every keystroke fires
	 * fldChangedEvent (MainFormHandleEvent) -- no separate Find button needed, same
	 * idiom as Datebook35's location pickers. No graffiti indicator on this field, so
	 * Cancel sits flush right (1px margin); the field fills the freed Find space. */
	FIELD	ID fldMainFind	AT (32 146 90 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 38
	BUTTON "Clear"			ID btnMainCancel	AT (126 146 33 12)
END

MENU ID mnuMain
BEGIN
	PULLDOWN "Record"
	BEGIN
		MENUITEM "New Contact"			ID mniMainNew		"N"
		MENUITEM "Delete Contact..."	ID mniMainDelete	"D"
		MENUITEM SEPARATOR
		MENUITEM "Beam Category"		ID mniMainBeam		"B"
		MENUITEM "Browse Card"			ID mniMainBrowseCard
		MENUITEM "Import CardDAV..."	ID mniMainDavImport
		MENUITEM "Import from Card"		ID mniMainImport
		MENUITEM "Export to Card"		ID mniMainExport
	END
	/* Standard system Edit menu (IDs = sysEditMenu*Cmd) so the Find field + any text
	 * entry gets Cut/Copy/Paste + the Graffiti command shortcuts. */
	PULLDOWN "Edit"
	BEGIN
		MENUITEM "Undo"					ID 10000	"U"
		MENUITEM "Cut"					ID 10001	"X"
		MENUITEM "Copy"					ID 10002	"C"
		MENUITEM "Paste"				ID 10003	"P"
		MENUITEM "Select All"			ID 10004	"S"
		MENUITEM SEPARATOR
		MENUITEM "Keyboard"				ID 10006	"K"
		MENUITEM "Graffiti Help"		ID 10007	"G"
	END
	PULLDOWN "Options"
	BEGIN
		MENUITEM "Font..."				ID mniMainFont		"F"
		MENUITEM "Preferences..."		ID mniMainPrefs		"R"
		MENUITEM "CardDAV..."			ID mniMainDav
		MENUITEM "About Address35"		ID mniMainAbout
	END
END

/* ---- Edit form: inline-editable, section-ordered field rows ------------ *
 * kEditRows physical [type-selector | value-field] rows are a scrolling window
 * onto the section-sorted field array; one shared type list drives the pickers.*/
FORM ID frmEdit AT (0 0 160 160)
	MENUID mnuEdit
BEGIN
	TITLE "Address35"
	POPUPTRIGGER ""			ID popEditCategory  AT (104 0 56 13) RIGHTANCHOR
	LIST ""					ID lstEditCategory  AT (84 1 76 1)
							VISIBLEITEMS 1 NONUSABLE
	POPUPLIST				ID popEditCategory lstEditCategory

	POPUPTRIGGER "First Name"	ID 1140	AT (0 16 58 13) LEFTANCHOR
	FIELD	ID 1150	AT (63 17 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120
	POPUPTRIGGER "First Name"	ID 1141	AT (0 30 58 13) LEFTANCHOR
	FIELD	ID 1151	AT (63 31 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120
	POPUPTRIGGER "First Name"	ID 1142	AT (0 44 58 13) LEFTANCHOR
	FIELD	ID 1152	AT (63 45 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120
	POPUPTRIGGER "First Name"	ID 1143	AT (0 58 58 13) LEFTANCHOR
	FIELD	ID 1153	AT (63 59 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120
	POPUPTRIGGER "First Name"	ID 1144	AT (0 72 58 13) LEFTANCHOR
	FIELD	ID 1154	AT (63 73 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120
	POPUPTRIGGER "First Name"	ID 1145	AT (0 86 58 13) LEFTANCHOR
	FIELD	ID 1155	AT (63 87 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120
	POPUPTRIGGER "First Name"	ID 1146	AT (0 100 58 13) LEFTANCHOR
	FIELD	ID 1156	AT (63 101 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120
	POPUPTRIGGER "First Name"	ID 1147	AT (0 114 58 13) LEFTANCHOR
	FIELD	ID 1157	AT (63 115 87 11) EDITABLE UNDERLINED SINGLELINE MAXCHARS 120

	/* ":" separators sit just left of each input, shown/hidden with the row */
	LABEL ":"	ID 1160	AT (58 17)
	LABEL ":"	ID 1161	AT (58 31)
	LABEL ":"	ID 1162	AT (58 45)
	LABEL ":"	ID 1163	AT (58 59)
	LABEL ":"	ID 1164	AT (58 73)
	LABEL ":"	ID 1165	AT (58 87)
	LABEL ":"	ID 1166	AT (58 101)
	LABEL ":"	ID 1167	AT (58 115)

	/* field-TYPE picker is now the searchable A35PickList (Graffiti/keyboard find),
	 * opened via ctlSelectEvent -> EditTypePick; no bound native popup list. */

	/* value pick-lists (positioned at the tapped row before popup) */
	LIST "Female" "Male" "Non-binary" "Other" "Unspecified" ID lstEditGender AT (68 16 82 65) VISIBLEITEMS 5 NONUSABLE
	LIST "she/her" "he/him" "they/them" "Other" ID lstEditPronouns AT (68 16 82 52) VISIBLEITEMS 4 NONUSABLE
	LIST "Mr." "Mrs." "Ms." "Miss" "Dr." "Prof." "Mx." ID lstEditPrefix AT (63 16 82 78) VISIBLEITEMS 7 NONUSABLE
	LIST "Twitter/X" "Instagram" "LinkedIn" "Facebook" "Mastodon" "Other" ID lstEditSocial AT (68 16 82 78) VISIBLEITEMS 6 NONUSABLE

	SCROLLBAR				ID sclEditFields	AT (152 16 7 112)
							VALUE 0 MIN 0 MAX 0 PAGESIZE 8
	BUTTON "Done"		ID btnEditDone		AT (1 147 26 12)
	BUTTON "Delete"		ID btnEditDelete	AT (PrevRight+4 147 30 12)
	BUTTON "+ Field"	ID btnEditAddField	AT (PrevRight+4 147 40 12)
	BUTTON "- Field"	ID btnEditDelField	AT (PrevRight+4 147 40 12)
	GRAFFITISTATEINDICATOR					AT (151 149)
END

MENU ID mnuEdit
BEGIN
	PULLDOWN "Record"
	BEGIN
		MENUITEM "Delete Contact..."	ID mniEditDelete	"D"
		MENUITEM "Beam Contact"			ID mniEditBeam		"B"
	END
	/* Standard system Edit menu (IDs = sysEditMenu*Cmd) for the editable value fields. */
	PULLDOWN "Edit"
	BEGIN
		MENUITEM "Undo"					ID 10000	"U"
		MENUITEM "Cut"					ID 10001	"X"
		MENUITEM "Copy"					ID 10002	"C"
		MENUITEM "Paste"				ID 10003	"P"
		MENUITEM "Select All"			ID 10004	"S"
		MENUITEM SEPARATOR
		MENUITEM "Keyboard"				ID 10006	"K"
		MENUITEM "Graffiti Help"		ID 10007	"G"
	END
END

/* ---- Record (read-only detail) form ------------------------------------ */
FORM ID frmRecord AT (0 0 160 160)
	MENUID mnuRecord
BEGIN
	TITLE "Address35"
	/* Change this contact's category directly from the read-only view, without
	 * entering Edit; hidden in card-browse mode (a card vCard has no category). */
	POPUPTRIGGER ""			ID popRecordCategory	AT (90 0 70 13) RIGHTANCHOR
	LIST ""					ID lstRecordCategory	AT (89 1 71 1)
							VISIBLEITEMS 1 NONUSABLE
	POPUPLIST				ID popRecordCategory lstRecordCategory
	TABLE					ID tblRecord	AT (0 16 152 128) ROWS 11 COLUMNS 1
							COLUMNWIDTHS 152
	SCROLLBAR				ID sclRecord	AT (153 16 7 128)
							VALUE 0 MIN 0 MAX 0 PAGESIZE 11
	BUTTON "Done"		ID btnRecordDone	AT (1 146 28 12)
	BUTTON "Edit"		ID btnRecordEdit	AT (PrevRight+4 146 28 12)
END

MENU ID mnuRecord
BEGIN
	PULLDOWN "Record"
	BEGIN
		MENUITEM "Set as me..."			ID mniRecordSetMe	"M"
		MENUITEM "Edit Contact"			ID mniRecordEdit	"E"
		MENUITEM "Duplicate Contact"	ID mniRecordDuplicate	"P"
		MENUITEM "Delete Contact..."	ID mniRecordDelete	"D"
		MENUITEM "Beam Contact"			ID mniRecordBeam	"B"
	END
	PULLDOWN "Edit"
	BEGIN
		MENUITEM "Copy Field"			ID mniRecordCopy	"C"
		MENUITEM "Copy Contact"			ID mniRecordCopyAll	"A"
	END
END

/* Full-field popup of the record view (RecField.c): the field's complete text, read-only and
 * scrolling, with Copy (button or Edit > Copy). */
FORM ID frmRecField AT (0 0 160 160)
	MENUID mnuRecField
BEGIN
	TITLE "Field"
	FIELD ID fldRecField AT (4 17 142 118) NONEDITABLE MULTIPLELINES
