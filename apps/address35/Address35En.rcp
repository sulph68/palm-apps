/* ---- shared searchable list picker ------------------------------------- *
 * Type-ahead (filters live, no separate Find button) + optional scrollbar;
 * driven by a nested loop in EditDialogs.c. */
FORM ID frmPick AT (2 2 156 156) MODAL
	MENUID mnuDlgEdit
BEGIN
	TITLE "Select"
	LIST ""				ID lstPick			AT (2 16 152 121) VISIBLEITEMS 11
	LABEL "Find:"		ID lblPickFind		AT (2 144) FONT 1
	FIELD	ID fldPickFind		AT (26 143 84 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 40
	BUTTON "Cancel"		ID btnPickCancel	AT (113 141 30 12)
	GRAFFITISTATEINDICATOR					AT (146 142)
END

/* ---- Phone Lookup (Lookup.c): small picker over the calling app ------- *
 * One row per contact, drawn by LkDrawRow; picking one pops up lstLookupItems
 * with that contact's phones/emails/social handles. Find is pre-filled with
 * the word being looked up. */
/* This form lives in a NewGlobals sublaunch, whose memory the OS frees on return.
 * Nothing here may make the system allocate state that outlives it: no MENUID
 * (Menu Manager), and Find is NOT an editable field - a focused field's blinking
 * insertion point keeps a saved-bits window, which would be freed under the
 * caller ("MemoryMgr.c, Invalid chunk ptr" on its next cursor blink). Lookup.c
 * handles the keystrokes itself and redraws Find. */
FORM ID frmLookup AT (0 0 160 160)
FRAME MODAL SAVEBEHIND
BEGIN
	TITLE "Phone Number Lookup"
	LIST ""				ID lstLookup		AT (4 15 150 110) VISIBLEITEMS 10
	LABEL "Find:"		ID lblLookupFind	AT (5 128) FONT 1
	FIELD	ID fldLookupFind	AT (31 127 84 12) NONEDITABLE UNDERLINED SINGLELINE MAXCHARS 24
	BUTTON "Paste"		ID btnLookupPaste	AT (5 143 36 12)
	BUTTON "Cancel"		ID btnLookupCancel	AT (45 143 38 12)
	/* which address book: Local or one CardDAV / iCloud book (same row and height as Cancel) */
	POPUPTRIGGER ""		ID popLookupSrc		AT (87 143 69 12) LEFTANCHOR
	LIST "1" "2" "3" "4" "5" "6" "7" "8" "9" ID lstLookupSrc AT (87 143 69 99) VISIBLEITEMS 9 NONUSABLE
	POPUPLIST ID popLookupSrc lstLookupSrc
	/* step 2: the picked contact's phones/emails/social handles (LstPopupList) */
	LIST ""				ID lstLookupItems	AT (2 15 152 11) VISIBLEITEMS 1 NONUSABLE
END

ALERT ID altLookupNone
INFORMATION
BEGIN
	TITLE "Phone Number Lookup"
	MESSAGE "No contacts have a phone number, email or social handle yet."
	BUTTONS "OK"
END

/* ---- Email value dialog (4 lines) -------------------------------------- *
 * L1: label popup (Home/Work/iCloud/Other)
 * L2: username + "@"   L3: domain popup (inline, category-style)
 * L4: "Other" checkbox (under the ^ arrow) + custom-domain field
 * Vertical layout: buttons sit 4px above the form bottom (kept a bit more
 * generous than the literal 2px spec, in case some border/shadow eats into
 * the declared height - flag if it still doesn't look bottom-aligned). */
FORM ID frmEmailDlg AT (2 58 156 100) MODAL
	MENUID mnuDlgEdit
BEGIN
	TITLE "Email Address"

	LABEL "Label:"				ID lblEmailLabel	AT (6 16)
	POPUPTRIGGER "Home"			ID popEmailLabel	AT (36 16 60 12) LEFTANCHOR
	LIST "Home" "Work" "iCloud" "Other" ID lstEmailLabel AT (36 16 60 48) VISIBLEITEMS 4 NONUSABLE
	POPUPLIST					ID popEmailLabel lstEmailLabel

	FIELD	ID fldEmailUser		AT (6 30 112 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 80
	LABEL "@"					ID lblEmailAt		AT (122 30)

	POPUPTRIGGER "gmail.com"	ID popEmailDomain	AT (20 45 124 12) LEFTANCHOR
	LIST "gmail.com" "mac.com" "icloud.com" "outlook.com" "yahoo.com" "hotmail.com" "proton.me" "protonmail.com" "fastmail.com" ID lstEmailDomain AT (20 45 124 90) VISIBLEITEMS 9 NONUSABLE
	POPUPLIST					ID popEmailDomain lstEmailDomain

	CHECKBOX ""					ID cbEmailOther		AT (21 59 12 12)
	LABEL "Other"				ID lblEmailOther	AT (36 59)
	FIELD	ID fldEmailCustom	AT (36 59 108 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 60 NONUSABLE

	BUTTON "OK"			ID btnEmailOK		AT (6 84 40 12)
	BUTTON "Cancel"		ID btnEmailCancel	AT (52 84 44 12)
	GRAFFITISTATEINDICATOR					AT (138 84)
END


