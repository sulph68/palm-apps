/* ---- Contact picker: searchable contact list for relationships --------- *
 * Type-ahead (filters live, no separate Find button), same idiom as frmPick. */
FORM ID frmContactPick AT (2 2 156 156) MODAL
	MENUID mnuDlgEdit
BEGIN
	TITLE "Pick a Contact"
	LIST ""				ID lstContactPick	AT (2 16 152 121) VISIBLEITEMS 11
	LABEL "Find:"		ID lblContactFind	AT (2 144) FONT 1
	FIELD	ID fldContactFind	AT (26 143 86 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 30
	BUTTON "Cancel"		ID btnContactCancel	AT (117 141 30 12)
	GRAFFITISTATEINDICATOR					AT (148 145)
END

/* ---- Preferences form -------------------------------------------------- */
FORM ID frmPrefs AT (2 20 156 138) MODAL
BEGIN
	TITLE "Preferences"
	LABEL "Name Label:"	ID 1310 AT (9 18) FONT 1
	POPUPTRIGGER "Surname"		ID popPrefsSurname	AT (72 17 62 13) LEFTANCHOR
	LIST "Surname" "Last Name" "Family Name" ID lstPrefsSurname
								AT (72 17 62 40) VISIBLEITEMS 3 NONUSABLE
	POPUPLIST					ID popPrefsSurname lstPrefsSurname

	LABEL "Sort Order By:"		ID 1311 AT (9 36) FONT 1
	LABEL "Primary:"			ID 1312 AT (20 50)
	POPUPTRIGGER "Last Name"	ID popPrefsPrimary	AT (72 49 70 13) LEFTANCHOR
	LIST "Last Name" "First Name" "Company" ID lstPrefsPrimary
								AT (72 49 70 40) VISIBLEITEMS 3 NONUSABLE
	POPUPLIST					ID popPrefsPrimary lstPrefsPrimary
	LABEL "Secondary:"			ID 1313 AT (20 66)
	POPUPTRIGGER "First Name"	ID popPrefsSecondary AT (72 65 70 13) LEFTANCHOR
	LIST "Last Name" "First Name" "Company" ID lstPrefsSecondary
								AT (72 65 70 40) VISIBLEITEMS 3 NONUSABLE
	POPUPLIST					ID popPrefsSecondary lstPrefsSecondary

	LABEL "Display:"			ID lblPrefsDisplay AT (9 84) FONT 1
	CHECKBOX "Show Hidden"		ID cbPrefsShowHidden AT (20 100 90 12)

	BUTTON "OK"			ID btnPrefsOK		AT (10 118 40 12)
	BUTTON "Cancel"		ID btnPrefsCancel	AT (PrevRight+6 118 40 12)
END

/* ---- About form -------------------------------------------------------- */
FORM ID frmAbout AT (2 50 156 108) MODAL
BEGIN
	TITLE "About Address35"
	LABEL "Address35 v1.0"						ID 1410 AT (CENTER 22) FONT 1
	LABEL "Modern era-aware address book."		ID 1411 AT (8 40) FONT 0
	LABEL "Multiple fields, tags, relations,"	ID 1412 AT (8 54) FONT 0
	LABEL "birthdays, vCard 3.0/4.0."			ID 1413 AT (8 66) FONT 0
	BUTTON "OK"				ID btnAboutOK		AT (CENTER 88 40 12)
END

/* ---- alerts ------------------------------------------------------------ */
ALERT ID altRomIncompatible
ERROR
BEGIN
	TITLE "System Incompatible"
	MESSAGE "Address35 requires Palm OS 4.0 or later."
	BUTTONS "OK"
END

ALERT ID altHackOff
INFORMATION
BEGIN
	TITLE "Era plugin not active"
	MESSAGE "The HackMaster Y2K35 plugin is not enabled. Address35 still works, " \
		"but birthday ages and Datebook35 Agenda integration need it."
	BUTTONS "OK"
END

ALERT ID altNotYet
INFORMATION
BEGIN
	TITLE "Coming soon"
	MESSAGE "This feature isn't implemented in this build yet."
	BUTTONS "OK"
END

ALERT ID altNoSelection
INFORMATION
BEGIN
	TITLE "No Contact Selected"
	MESSAGE "Open a contact first, then use Delete Contact to remove it."
	BUTTONS "OK"
END

ALERT ID altNoCard
INFORMATION
BEGIN
	TITLE "No Card"
	MESSAGE "Insert an SD card to import or export vCards."
	BUTTONS "OK"
END

ALERT ID altDavLocked
INFORMATION
BEGIN
	TITLE "Sec35 Locked"
	MESSAGE "Unlock Sec35 to read these contacts."
	BUTTONS "OK"
END

ALERT ID altDavInfo
INFORMATION
BEGIN
	TITLE "CardDAV"
	MESSAGE "^1"
	BUTTONS "OK"
END

ALERT ID altDavImportAsk
CONFIRMATION
BEGIN
	TITLE "Import CardDAV"
	MESSAGE "Import the ^1 contacts in this list into Address35? Import copies all of them; Skip Duplicates leaves out contacts whose last name, first name and company are already in Address35."
	BUTTONS "Import" "Skip Duplicates" "Cancel"
END

ALERT ID altDavImportDone
INFORMATION
BEGIN
	TITLE "Import CardDAV"
	MESSAGE "^1 contacts imported into Address35.^2"
	BUTTONS "OK"
END

ALERT ID altDavReadOnly
INFORMATION
BEGIN
	TITLE "Read-only"
	MESSAGE "CardDAV contacts are read-only. Choose Local in Options > CardDAV to add or beam contacts."
	BUTTONS "OK"
END

ALERT ID altDavNoSync
INFORMATION
BEGIN
	TITLE "CalDAV Sync"
	MESSAGE "CalDAV Sync is not installed."
	BUTTONS "OK"
END

/* Options > CardDAV...: which book the list shows, and a way to CalDAV Sync.
 * The list gets "Local" and each contacts slot's "iCloud - Alias" at run time. */
FORM ID frmDav AT (2 62 156 96)
FRAME MODAL SAVEBEHIND
BEGIN
	TITLE "CardDAV"

	LABEL "Show:" AUTOID AT (RIGHT@36 20) FONT 1
	POPUPTRIGGER "" ID popDavShow AT (38 20 114 12) LEFTANCHOR
	LIST "1" "2" "3" "4" "5" "6" "7" "8" "9" ID lstDavShow AT (42 16 110 99) VISIBLEITEMS 9 NONUSABLE
	POPUPLIST ID popDavShow lstDavShow

	LABEL "Synced contacts are read-only here." AUTOID AT (4 42) FONT 0
	LABEL "Use Import to copy one to Address35." AUTOID AT (4 53) FONT 0

	BUTTON "OK"		ID btnDavOK		AT (4 78 36 14)
	BUTTON "Cancel"	ID btnDavCancel	AT (44 78 44 14)
	BUTTON "Sync..."	ID btnDavSync	AT (116 78 36 14)
END

ALERT ID altCardEmpty
INFORMATION
BEGIN
	TITLE "Browse Card"
	MESSAGE "No vCards found under /Address/. Put .vcf files there to browse them."
	BUTTONS "OK"
END

ALERT ID altSetMe
CONFIRMATION
BEGIN
	TITLE "Set as Me"
	MESSAGE "Make this contact your Me card? It will always show first, in bold."
	BUTTONS "OK" "Cancel"
END

ALERT ID altNoSec35
INFORMATION
BEGIN
	TITLE "Cannot Decrypt"
	MESSAGE "This address book has encrypted records, but the Sec35 security " \
			"app is not installed. Install Sec35 to unlock your data."
	BUTTONS "OK"
END

ALERT ID altCardGroupSplit
CONFIRMATION
BEGIN
	TITLE "Group vCard"
	MESSAGE "This file contains ^1 contacts. Split into individual contacts?"
	BUTTONS "OK" "Cancel"
END

ALERT ID altCardSplitFailed
ERROR
BEGIN
	TITLE "Split Failed"
	MESSAGE "Could not write the split contacts to the card (write failed - check " \
			"free space). The original file was left unchanged."
	BUTTONS "OK"
END

ALERT ID altCardTooMany
WARNING
BEGIN
	TITLE "Too Many Files"
	MESSAGE "This folder has more files than Address35 can show. Only the first " \
			"256 are listed."
	BUTTONS "OK"
END

ALERT ID altExportScope
CONFIRMATION
BEGIN
	TITLE "Export to Card"
	MESSAGE "Which contacts should be written to /Address/Export/ as vCards?"
	BUTTONS "This Category" "All" "Cancel"
END

ALERT ID altImportDone
INFORMATION
BEGIN
	TITLE "Import from Card"
	MESSAGE "Imported ^1 contact(s) from /Address/Import/."
	BUTTONS "OK"
END

ALERT ID altExportDone
INFORMATION
BEGIN
	TITLE "Export to Card"
	MESSAGE "Exported ^1 contact(s) to /Address/Export/."
	BUTTONS "OK"
END

ALERT ID altDelFieldWarn
CONFIRMATION
BEGIN
	TITLE "Remove Fields"
	MESSAGE "Remove the unchecked field(s)? Their data cannot be recovered."
	BUTTONS "Remove" "Cancel"
END
