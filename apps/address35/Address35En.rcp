/* Progress dialog with a real bar ("Processing vCard...", "Importing...") -
 * same 2px-margin/156-wide convention as every other dialog in this app; the
 * bar itself is hand-drawn by the C code (AddrCard.c A35ProgressBegin/Bar/
 * End), same idiom as Sec35's own "Working" progress dialog. */
FORM ID frmCardProgress AT (2 54 156 52)
MODAL
BEGIN
	TITLE "Working"
END

/* Duplicate-filename prompt: shown by A35CardUniquePath (AddrCard.c) when a
 * Split or Export write collides with an existing file. Bottom-aligned the
 * SAME way as every other dialog in this app (frmEmailDlg/frmPhoneDlg/
 * frmSocialDlg/etc.): the form's own bottom edge sits at y=158 (2px above
 * the 160px screen bottom, not vertically centered) - AT's y = 158 - h.
 * Buttons sit 4px above the form's own base (h=80, buttons at y=64,
 * 64+12=76, 80-76=4); checkbox row 4px above the buttons. */
FORM ID frmDupFile AT (2 78 156 80) MODAL
BEGIN
	TITLE "Duplicate File"
	LABEL "Same filename already"		ID lblDupMsg1		AT (6 18) FONT 1
	LABEL "exists. What should I do?"	ID lblDupMsg2		AT (6 30) FONT 1
	CHECKBOX ""				ID cbDupApplyAll	AT (6 48 12 12)
	LABEL "Apply to all"			ID lblDupApplyAll	AT (22 48) FONT 1
	BUTTON "Replace"	ID btnDupReplace	AT (4 64 46 12)
	BUTTON "Keep Both"	ID btnDupKeepBoth	AT (54 64 50 12)
	BUTTON "Cancel"		ID btnDupCancel		AT (108 64 44 12)
END

