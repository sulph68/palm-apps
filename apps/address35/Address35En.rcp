	BUTTON "Done" ID btnRecFieldDone AT (4 143 36 12)
	BUTTON "Copy" ID btnRecFieldCopy AT (46 143 40 12)
END

MENU ID mnuRecField
BEGIN
	PULLDOWN "Edit"
	BEGIN
		MENUITEM "Copy"					ID mniRecFieldCopy	"C"
	END
END

