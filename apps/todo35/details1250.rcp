/* Td35: Change Repeat dialog (form 1250) -- geometry matched to Datebook35's
 * Repeat dialog (form 1400) exactly. Writes gDetailsExt.repeat. */
FORM ID 1250 AT (2 2 156 156)
MODAL
BEGIN
  TITLE "Change Repeat"
  PUSHBUTTON "None" ID 1252 AT (7 20 26 11) GROUP 3
  PUSHBUTTON "Day" ID 1253 AT (34 20 23 11) GROUP 3
  PUSHBUTTON "Week" ID 1254 AT (58 20 30 11) GROUP 3
  PUSHBUTTON "Month" ID 1255 AT (89 20 32 11) GROUP 3
  PUSHBUTTON "Year" ID 1256 AT (122 20 25 11) GROUP 3
  LABEL "Every:" ID 1257 AT (24 38) FONT 1 NONUSABLE
  FIELD ID 1258 AT (60 38 17 11) MAXCHARS 3 UNDERLINED NONUSABLE
  LABEL "Day(s)" ID 1259 AT (83 38) FONT 1 NONUSABLE
  LABEL "Week(s)" ID 1260 AT (83 38) FONT 1 NONUSABLE
  LABEL "Month(s)" ID 1261 AT (83 38) FONT 1 NONUSABLE
  LABEL "Year(s)" ID 1262 AT (83 38) FONT 1 NONUSABLE
  LABEL "End on:" ID 1263 AT (21 55) FONT 1 NONUSABLE
  POPUPTRIGGER "No End Date" ID 1264 AT (60 55 88 13) NONUSABLE
  LIST "No End Date" "Choose Date..." ID 1265 AT (60 58 70 1) VISIBLEITEMS 2 NONUSABLE
  LABEL "Repeat on:" ID 1266 AT (5 72) FONT 1 NONUSABLE
  PUSHBUTTON "S" ID 1267 AT (63 72 10 12) NONUSABLE
  PUSHBUTTON "M" ID 1268 AT (74 72 10 12) NONUSABLE
  PUSHBUTTON "T" ID 1269 AT (85 72 10 12) NONUSABLE
  PUSHBUTTON "W" ID 1270 AT (96 72 10 12) NONUSABLE
  PUSHBUTTON "T" ID 1271 AT (107 72 10 12) NONUSABLE
  PUSHBUTTON "F" ID 1272 AT (118 72 10 12) NONUSABLE
  PUSHBUTTON "S" ID 1273 AT (129 72 10 12) NONUSABLE
  LABEL "Repeat by:" ID 1274 AT (5 72) FONT 1 NONUSABLE
  PUSHBUTTON "Day" ID 1275 AT (63 72 40 12) GROUP 4 NONUSABLE
  PUSHBUTTON "Date" ID 1276 AT (104 72 40 12) GROUP 4 NONUSABLE
  LABEL "Tap one of the above\rbuttons to set a repeat\rinterval." ID 1277 AT (7 38) FONT 1 NONUSABLE
  FIELD ID 1280 AT (10 100 136 22) MULTIPLELINES MAXCHARS 200
  BUTTON "OK" ID 1278 AT (4 140 25 12)
  BUTTON "Cancel" ID 1279 AT (35 140 36 12)
  POPUPLIST ID 1264 1265
END
