								"option will store deleted " \
								"records in an archive file on " \
								"your desktop computer at " \
								"the next Hotsynch. Some " \
								"records will be hidden but " \
								"not deleted until then."


FORM ID frmAboutForm AT (2 36 156 122)
FRAME MODAL
HELPID strAboutHelpString
BEGIN
	TITLE "About CryptoNote"
	FORMBITMAP AT (5 17) BITMAP bmpCryptoPadIcon
	LABEL "CryptoNote 3.65"					AUTOID AT (32 16) FONT 1
	LABEL "Adds SD-card notes to"			AUTOID AT (32 27) FONT 1
	LABEL "CryptoPad by Maxime & JB Labelle"	AUTOID AT (5 38)
	LABEL "http://cryptopad.sourceforge.net/"	AUTOID AT (5 50)
	LABEL "Contains cryptographic software"		AUTOID AT (5 61)
	LABEL "by Eric Young. AES-128-CTR added"			AUTOID AT (5 72)
	LABEL "by Benjamin Khoo via Claude"			AUTOID AT (5 83)
	BUTTON "OK" AUTOID AT (60 106 38 AUTO)
END

STRING ID strAboutHelpString	"CryptoNote extends CryptoPad " \
								"with SD-card notes (the \"Card\" " \
								"category) that can be read, " \
								"edited and encrypted per file " \
								"with the same AES model as the " \
								"built-in encrypted notes.\n" \
								"\n" \
								"Notice that while beaming " \
								"a memo, receiver must exit " \
								"from CryptoNote in order to " \
								"receive it."



