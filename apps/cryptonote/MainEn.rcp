ALERT ID altConfirmDeleteAlert
CONFIRMATION
BEGIN
	TITLE "Delete Memo"
	MESSAGE "Delete this memo?"
	BUTTONS "OK" "Cancel"
END

ALERT ID altInvalidPasswordAlert
ERROR
BEGIN
	TITLE "Password"
	MESSAGE "Incorrect password. \nPlease retry."
	BUTTONS "OK"
END

ALERT ID altGlobalPasswordNotMatchAlert
INFORMATION
BEGIN
	TITLE "Global Password"
	MESSAGE "The password you entered do not match.\n" \
			"Please try again."
	BUTTONS "OK"
END

ALERT ID altConfirmDeleteForgottenPasswordAlert
INFORMATION
BEGIN
	TITLE "Global Password"
	MESSAGE "Deleting a forgotten password will remove all records crypted with the global password. " \
			"Do you wish to proceed?"
	BUTTONS "Yes" "No"
END

ALERT ID altNoGlobalPasswordToDeleteAlert
ERROR
HELPID strDeleteForgottenPassword
BEGIN
	TITLE "Delete Global Password"
	MESSAGE "There is no global password to delete."
	BUTTONS "OK"
END

STRING ID strDeleteForgottenPassword "This feature lets you delete a forgotten global" \
				"password.\nAll records previously crypted with the global password are removed."

ALERT ID altInvalidGlobalPasswordAlert
ERROR
BEGIN
	TITLE "Global password"
	MESSAGE "Incorrect global password. \nPlease retry."
	BUTTONS "OK"
END

ALERT ID altUseNoGlobalPasswordAlert
INFORMATION
BEGIN
	TITLE "Password"
	MESSAGE "This record was not crypted with the global password.\n" \
			"Please retry with another password."
	BUTTONS "OK"
END

ALERT ID altEncryptRecordWithGlobalPasswordAlert
INFORMATION
BEGIN
	TITLE "Encrypt Record"
	MESSAGE "The current record will be encrypted with the global password."
	BUTTONS "OK"
END

ALERT ID altEncryptCategoryWithGlobalPasswordAlert
INFORMATION
BEGIN
	TITLE "Encrypt Category"
	MESSAGE "The current category will be encrypted with the global password."
	BUTTONS "OK"
END

ALERT ID altCategoryAlreadyEncryptedAlert
INFORMATION
BEGIN
	TITLE "Encrypt Category"
	MESSAGE "The current category is already encrypted."
	BUTTONS "OK"
END

ALERT ID altCategoryAlreadyDecryptedAlert
INFORMATION
BEGIN
	TITLE "Decrypt Category"
	MESSAGE "The current category is already decrypted."
	BUTTONS "OK"
END

ALERT ID altInvalidFormatAlert
ERROR
BEGIN
	TITLE "Encryption Error"
	MESSAGE "The memo should at least contain two lines."
	BUTTONS "OK"
END

ALERT ID altRemovePasswdAlert
INFORMATION
BEGIN
	TITLE "Password"
	MESSAGE "The memo is no longer password protected."
	BUTTONS "OK"
END

ALERT ID altAlphabeticSortAlert
INFORMATION
BEGIN
	TITLE "Alphabetic Sort"
	MESSAGE "The current sort order will be lost if the memos are sorted " \
			"alphabetically. Are you sure you wish to sort the memos ?"
	BUTTONS "OK" "Cancel"
END

ALERT ID altRomIncompatibleAlert
ERROR
BEGIN
	TITLE "ROM Version"
	MESSAGE "ROM version 3.0 or higher is required for this program to run correctly."
	BUTTONS "OK"
END

ALERT ID altMoveRecordOnTopImpossibleAlert
INFORMATION
BEGIN
	TITLE "Move records on top"
	MESSAGE "You must set the sort order to Manual to use the \"Move records " \
			"on top\" feature."
	BUTTONS "OK"
END

ALERT ID altMigrateMemoPadAlert
CONFIRMATION
BEGIN
	TITLE "Memo Pad"
	MESSAGE "^1 memo(s) found in Memo Pad. Migrate them into CryptoNote? " \
			"They will be removed from Memo Pad."
	BUTTONS "OK" "Cancel"
END

ALERT ID altUseSingleFontAlert
INFORMATION
BEGIN
	TITLE "Use Single Font"
	MESSAGE "The separate font settings will be lost if you use a single " \
			"font.\nAre you sure you wish to use a single font ?"
	BUTTONS "OK" "Cancel"
END

ALERT ID altChangeTableFontOfCategoryAllAlert
INFORMATION
BEGIN
	TITLE "Font"
	MESSAGE "You are using separate fonts for categories so you cannot " \
	"change the font for the category All.\n" \
	"Select a category before invoking the font command."
	BUTTONS "OK"
END

ALERT ID altBeamCryptoDataAlert
INFORMATION
BEGIN
	TITLE "Beam"
	MESSAGE "You can't beam crypted record."
	BUTTONS "OK"
END

ALERT ID altDebugAlert
BEGIN
	TITLE "Debug Alert"
	MESSAGE "^1"
	BUTTONS "OK"
END


ALERT ID altCardNewNoName
ERROR
BEGIN
	TITLE "New Note"
	MESSAGE "Please enter a name for the note."
	BUTTONS "OK"
END

ALERT ID altCardNewExists
ERROR
BEGIN
	TITLE "New Note"
	MESSAGE "A file with that name already exists. Please choose a different name."
	BUTTONS "OK"
END

ALERT ID altCardBadPassword
ERROR
BEGIN
	TITLE "Password"
	MESSAGE "Incorrect password. \nPlease retry."
	BUTTONS "OK"
END

ALERT ID altCardReencrypt
CONFIRMATION
BEGIN
	TITLE "Encrypted File"
	MESSAGE "File was originally encrypted. Save file back as an encrypted file?"
	BUTTONS "Yes" "New Password" "No"
END

ALERT ID altCardDeletePlain
CONFIRMATION
BEGIN
	TITLE "Encrypt File"
	MESSAGE "Delete the original plaintext file?"
	BUTTONS "Delete" "Keep"
END

ALERT ID altCardTooLarge
CONFIRMATION
BEGIN
	TITLE "Open File"
	MESSAGE "This file is too large to edit directly (max ~60 KB). It can " \
			"still be imported into CryptoNote as ^1 memo(s) instead. Import?"
	BUTTONS "Import" "Cancel"
END

ALERT ID altCardNoBeam
INFORMATION
BEGIN
	TITLE "Beam"
	MESSAGE "Beaming card files is not supported."
	BUTTONS "OK"
END

ALERT ID altCardEncAll
CONFIRMATION
BEGIN
	TITLE "Encrypt All"
	MESSAGE "Every note in this folder will be encrypted with the SAME password. If you forget it, all of them are lost. Continue?"
	BUTTONS "Encrypt All" "Cancel"
END

ALERT ID altCardImportConfirm
CONFIRMATION
BEGIN
	TITLE "Import to CryptoNote"
	MESSAGE "This will create ^1 memo(s) in CryptoNote. The file on the " \
			"card is not changed. Continue?"
	BUTTONS "Import" "Cancel"
END

ALERT ID altCardImportComplete
INFORMATION
BEGIN
	TITLE "Import to CryptoNote"
	MESSAGE "Import complete: ^1 memo(s) created."
	BUTTONS "OK"
END

ALERT ID altCardImportFailed
ERROR
BEGIN
	TITLE "Import to CryptoNote"
	MESSAGE "Import failed: only ^1 memo(s) created. The file on the " \
			"card is unchanged."
	BUTTONS "OK"
END

ALERT ID altCardOpenFailed
ERROR
BEGIN
	TITLE "Open File"
	MESSAGE "This file could not be opened. (error ^1)"
	BUTTONS "OK"
END

ALERT ID altRecordTooLargeToEdit
ERROR
BEGIN
	TITLE "Memo Too Large"
	MESSAGE "This memo is too large to edit safely. Please create a new " \
			"memo for any further changes instead."
	BUTTONS "OK"
END
