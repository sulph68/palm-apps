MENU ID mnuMainMenu
BEGIN
	PULLDOWN "Record"
	BEGIN
		MENUITEM "Beam Category"			ID itemRecordBeamCategory
		MENUITEM SEPARATOR
		MENUITEM "Encrypt Category..."		ID itemRecordEncryptCategory
		MENUITEM "Decrypt Category..."		ID itemRecordDecryptCategory
	END

	PULLDOWN "Options"
	BEGIN
		MENUITEM "Font..."			ID itemOptionsFont "F"
		MENUITEM "Preferences..."	ID itemOptionsPrefs "R"
		MENUITEM "About CryptoNote" 	ID itemOptionsAbout
	END
END

MENU ID mnuEditMenu
BEGIN
	PULLDOWN "Record"
	BEGIN
		MENUITEM "New Memo"				ID itemRecordNewMemo	"N"
		MENUITEM "Delete Memo..."		ID itemRecordDeleteMemo	"D"
		MENUITEM "Beam Memo"			ID itemRecordBeamMemo	"B"
		MENUITEM SEPARATOR
		MENUITEM "Encrypt Memo..."		ID itemRecordEncryptMemo "Y"
		MENUITEM "Import to CryptoNote..." ID itemRecordImportToCrypto
	END

	PULLDOWN "Edit"
	BEGIN
		MENUITEM "Undo"					ID 10000 "U"
		MENUITEM "Cut"					ID 10001 "X"
		MENUITEM "Copy"					ID 10002 "C"
		MENUITEM "Paste"				ID 10003 "P"
		MENUITEM "Select All"			ID 10004 "S"
		MENUITEM SEPARATOR
		MENUITEM "Keyboard"				ID 10006 "K"
		MENUITEM "Graffiti"				ID 10007 "G"
	END

	PULLDOWN "Options"
	BEGIN
		MENUITEM "Font..."				ID itemOptionsFont "F"
		MENUITEM "Go to Top of Page" 	ID itemOptionsGoTopOfPage
		MENUITEM "Go to Bottom of Page" ID itemOptionsGoBottomOfPage
		MENUITEM "About CryptoNote" 	ID itemOptionsAbout
	END
END

