	BUTTON "OK"				ID btnDeleteOK		AT (5 80 37 12)
	BUTTON "Cancel"			ID btnDeleteCancel	AT (48 80 37 12)
END

STRING ID strDeleteHelpString	"The Save Archive Copy " \
								"option will store deleted " \
								"records in an archive file on " \
								"your desktop computer at " \
								"the next Hotsynch. Some " \
								"records will be hidden but " \
								"not deleted until then."


FORM ID frmAboutForm AT (2 30 156 128)
FRAME MODAL
HELPID strAboutHelpString
BEGIN
	TITLE "About CryptoNote"
	FORMBITMAP AT (5 21) BITMAP bmpCryptoPadIcon
	LABEL "CryptoNote 3.65"					AUTOID AT (32 20) FONT 1
	LABEL "Adds SD-card notes to"			AUTOID AT (32 32) FONT 1
	LABEL "CryptoPad by Maxime & JB Labelle"	AUTOID AT (5 44)
	LABEL "http://cryptopad.sourceforge.net/"	AUTOID AT (5 56)
	LABEL "Contains cryptographic software"		AUTOID AT (5 68)
	LABEL "by Eric Young. AES-128-CTR added"			AUTOID AT (5 80)
	LABEL "by Benjamin Khoo via Claude"			AUTOID AT (5 92)
	BUTTON "OK" AUTOID AT (CENTER 111 37 12)
END

STRING ID strAboutHelpString	"CryptoNote extends CryptoPad " \
								"with SD-card notes (the \"Card\" " \
								"category) that can be read, " \
								"edited and encrypted per file " \
								"with the same AES model as the " \
								"built-in encrypted notes.\n" \
								"\n" \
								"Notice that while beaming " \
								"a memo, receiver must exit " \
								"from CryptoNote in order to " \
								"receive it."



