END


STRING ID strSetGlobalPasswordHelpString "� Enter a password to set " \
					"the global password.\n" \
					"\n" \
					"� This global password will become the current " \
					"password and will be used for both encryption " \
					"and decryption. Make sure not to forget it as " \
					"it will be impossible to restore the contents " \
					"of the memo crypted with this password."

