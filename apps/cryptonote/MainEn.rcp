FORM ID frmPrefsForm AT (2 3 156 155)
FRAME MODAL
HELPID strPrefsHelpString
BEGIN
	TITLE "Preferences memos"
	LABEL "Sort by:"		AUTOID				AT (8 16) FONT 0
	POPUPTRIGGER ""			ID popPrefsSortOrder AT (44 PrevTop 70 13)
							LEFTANCHOR
	LIST "Manual" "Alphabetic"
							ID lstPrefsSortOrder   AT (44 PrevTop 70 1)
							VISIBLEITEMS 2 NONUSABLE
	POPUPLIST				popPrefsSortOrder lstPrefsSortOrder
	LABEL "Move records on top"		AUTOID				AT (24 30) FONT 0
	CHECKBOX ""				ID chkPrefsMoveRecordOnTop AT (5  PrevTop AUTO AUTO)
	LABEL "Show lines"		AUTOID				AT (24 41) FONT 0
	CHECKBOX ""				ID chkPrefsShowLines AT (5  PrevTop AUTO AUTO)
	LABEL "Show Hidden"		AUTOID				AT (24 52) FONT 0
	CHECKBOX ""				ID chkPrefsShowHidden AT (5  PrevTop AUTO AUTO)
	LABEL "Use single font"		AUTOID				AT (24 63) FONT 0
	CHECKBOX ""				ID chkPrefsUseSingleFont AT (5 PrevTop AUTO AUTO)
	LABEL "Rotate between:"		AUTOID				AT (8 74) FONT 0
	POPUPTRIGGER ""			ID popPrefsRotateOrder AT (78 PrevTop 70 13)
							LEFTANCHOR
	LIST "All" "All-Unfiled" "Categ.-Unfiled"
							ID lstPrefsRotateOrder   AT (78 PrevTop PrevWidth 1)
							VISIBLEITEMS 3  NONUSABLE
	LABEL "Global Password Features:"		AUTOID				AT (7 89) FONT 1
	LABEL "Global password:"		AUTOID				AT (7 103) FONT 0
	SELECTORTRIGGER "-Unassigned-"		ID selPrefsGlobalPassword AT (80 PrevTop AUTO AUTO)
							LEFTANCHOR
	BUTTON "Forgotten Password..."				ID btnPrefsForgotten		AT (20 119 112 AUTO)
	BUTTON "OK"				ID btnPrefsOK		AT (6 137 38 AUTO)
	BUTTON "Cancel"			ID btnPrefsCancel	AT (50 PrevTop 38 AUTO)
END

STRING ID strPrefsHelpString 	"� Sort by Manual allows " \
							"manual sorting of memos by "\
							"dragging them up and down " \
							"the list. To drag, pen down " \
							"on a memo and drag it to the " \
							"desired order and lift up the " \
							"pen.\n" \
							"\n" \
							"� Sort by Alphabetic sorts " \
							"memos alphabetically. This " \
							"sort order will overwrite " \
							"the current sort order.\n" \
							"\n" \
							"� Move record on top move " \
							"at the top of the list each " \
							"consulted memo.\n" \
							"\n" \
							"� Show lines allows to " \
							"display or hide the underlining " \
							"in the edit form.\n" \
							"\n" \
							"� Use single font allows to " \
							"use a separate font for each " \
							"record in the edit form and for " \
							"each category in the main view.\n" \
							"\n" \
							"� Rotate between lets the user " \
							"choose which categories are displayed " \
							"when hiting the hard key of the " \
							"application to switch from categories.\n" \
							"\"All-Unfiled\" goes also in the " \
							"\"Unfiled\" category while " \
							"\"Categ.-Unfiled\" jump the \"All\" " \
							"category.\n" \
							"\n" \
							"� Global password allows " \
							"user to assign a global " \
							"password for all new crypted " \
							"memos."

