VERSION ID 1 "3.65"

FORM ID frmMainForm AT (0 0 160 160)
NOFRAME
MENUID mnuMainMenu
BEGIN
	TITLE "CryptoNote"
	POPUPTRIGGER ""			ID popMainCategory   AT (90 0 70 13)
							RIGHTANCHOR
	LIST ""					ID lstMainCategory   AT (89 1 71 1)
							VISIBLEITEMS 5 NONUSABLE
	POPUPLIST				ID popMainCategory lstMainCategory
	TABLE					ID tblMainRecordList AT (0 18 152 124)
							ROWS 11 COLUMNS 1
							COLUMNWIDTHS 151
	SCROLLBAR				ID sclMainScrollBar  AT (153 PrevTop 7 121)
							VALUE 0 MIN 0 MAX 10 PAGESIZE 10 
	BUTTON "New"			ID btnMainNewMemo    AT (1 147 26 12)
	/* Find bar: [New] __field__ [Clear]. Filters live as every keystroke fires
	 * fldChangedEvent (MainFormHandleEvent) -- same idiom as Address35's list-view
	 * Find bar. In card mode filters filenames; otherwise filters memo titles. */
	FIELD	ID fldMainFind			AT (32 148 90 12) EDITABLE UNDERLINED SINGLELINE MAXCHARS 38
	BUTTON "Clear"			ID btnMainClear		AT (126 147 33 12)
END

FORM ID frmProgressForm AT (2 78 156 80)
FRAME MODAL
BEGIN
	TITLE "Progress"
	GADGET 					ID gadProgressMessage AT (10 25 140 15)
	GADGET 					ID gadProgressBar AT (10 52 140 7)
END

FORM ID frmEditForm AT (0 0 160 160)
NOFRAME
MENUID mnuEditMenu
BEGIN
	/* Padded to cardMaxName (64, see CardIO.h) - EditRetrieveCardFile calls
	 * FrmCopyTitle(formP, gCardEditName) to title this form with a card
	 * file's leaf name, which can be as long as cardMaxName. FrmCopyTitle
	 * writes into THIS string's compiled buffer size, never reallocating -
	 * an unpadded short placeholder here overflows and silently corrupts
	 * the heap for any card filename longer than the placeholder (same bug
	 * class as EraNTP.md S4 / lazyFTP.md S5's FrmCopyLabel crash - see
	 * memory palmos-frmcopylabel-buffer-size-gotcha). Normal (non-card)
	 * memo editing never calls FrmCopyTitle, so the form just shows this
	 * text as-is - trailing spaces are clipped by the title bar's own draw
	 * width, same idiom as Sec35's lblCountdown/lblSession and CryptoNote's
	 * own label ID 1013. */
	TITLE "Memo                                                            "
	SELECTORTRIGGER ""		ID popEditCategory   AT (89 1 70 11)
							RIGHTANCHOR
	LIST ""					ID lstEditCategory   AT (83 1 76 1)
							VISIBLEITEMS 5 NONUSABLE
	POPUPLIST				ID popEditCategory lstEditCategory
	FIELD					ID fldEditText       AT (0 16 153 125)
							MULTIPLELINES UNDERLINED HASSCROLLBAR
							AUTOSHIFT MAXCHARS 65000
	LABEL ">4k"				ID lblEditMaxSize	AT (145 148 ) FONT 0 NONUSABLE
	SCROLLBAR				ID sclEditScrollBar  AT (153 18 7 122)
							VALUE 0 MIN 0 MAX 10 PAGESIZE 10
	BUTTON "Done"			ID btnEditTerminate  AT (1 147 30 12)
	BUTTON "Details"		ID btnEditDetails    AT (PrevRight+6 PrevTop 34 12)
	GRAFFITISTATEINDICATOR	                     AT (135 PrevTop)
END

STRING ID	strEditTitleMemo "Memo # of "

FORM ID frmDetailsForm AT (2 86 156 72)
FRAME MODAL
HELPID strDetailsHelpString
BEGIN
	TITLE "Memo Details"
	LABEL "Category:"		AUTOID				AT (5 18) FONT 1
	POPUPTRIGGER ""			ID popDetailsCategory AT (57 PrevTop 70 13)
							LEFTANCHOR
	LIST ""					ID lstDetailsCategory   AT (57 18 76 1)
							VISIBLEITEMS 5 NONUSABLE
	POPUPLIST				ID popDetailsCategory lstDetailsCategory
	LABEL "Private:"		AUTOID              AT (13 32) FONT 1
	CHECKBOX ""				ID chkDetailsPrivate AT (58 PrevTop AUTO AUTO)
	BUTTON "OK"				ID btnDetailsOK		AT (6 54 38 AUTO)
	BUTTON "Cancel"			ID btnDetailsCancel	AT (PrevRight+6 PrevTop 38 AUTO)
	BUTTON "Delete..."		ID btnDetailsDelete	AT (PrevRight+6 PrevTop 40 AUTO)
END

STRING ID strDetailsHelpString "� The category displayed in\n" \
					"the Memo List screen is\n" \
					"assigned automatically to\n" \
					"new Memos\n" \
					"\n" \
					"� There are two ways to\n" \
					"change the category of a\n" \
					"memo:\n" \
					"\n" \
					"1. Select a new category in\n" \
					"the Memo Details dialog.\n" \
					"2. While in memo edit view,\n" \
					"choose a new category from\n" \
					"the pick list."

FORM ID frmPasswordForm AT (2 75 156 83)
FRAME MODAL
HELPID strPasswordHelpString
BEGIN
	TITLE "Password"
	FORMBITMAP 	AT (5 20) BITMAP 10005
	LABEL "Enter a password:"		AUTOID			AT (30 PrevTop) FONT 1
	FIELD					ID fldPasswordText		 AT (5 42 146 13)
							SINGLELINE UNDERLINED
							MAXCHARS 56
	BUTTON "OK"				ID btnPasswordOK		 AT (6 65 38 AUTO)
	BUTTON "Cancel"			ID btnPasswordCancel	 AT (PrevRight+6 PrevTop 38 AUTO)
	BUTTON "Forget..."		ID btnPasswordForget	 AT (PrevRight+6 PrevTop 40 AUTO)
	GRAFFITISTATEINDICATOR	                         AT (144 PrevTop)
END

STRING ID strPasswordHelpString "� Enter a password to encrypt " \
					"the memo.\n" \
					"\n" \
					"� The password will be used for both encryption " \
					"and decryption. Make sure not to forget it as " \
					"it will be impossible to restore the contents " \
					"of the memos crypted with this password."

/* Numeric keypad for password entry (Preferences > Password Type in Sec35).
 * Layout is a 1-for-1 copy of Sec35's own frmKeypad (sec35.rcp) -- same
 * digit-grid geometry, same GADGET-based custom hit-test/draw approach
 * (see PasswordForm.c). */
FORM ID frmKeypadForm AT (2 2 156 156)
MODAL
BEGIN
	TITLE "Enter Password"
	GADGET ID 11001			AT (5 30 46 22) USABLE
	GADGET ID 11002			AT (55 30 46 22) USABLE
	GADGET ID 11003			AT (105 30 46 22) USABLE
	GADGET ID 11004			AT (5 56 46 22) USABLE
	GADGET ID 11005			AT (55 56 46 22) USABLE
	GADGET ID 11006			AT (105 56 46 22) USABLE
	GADGET ID 11007			AT (5 82 46 22) USABLE
	GADGET ID 11008			AT (55 82 46 22) USABLE
	GADGET ID 11009			AT (105 82 46 22) USABLE
	GADGET ID kpdDel		AT (5 108 46 22) USABLE
	GADGET ID kpd0			AT (55 108 46 22) USABLE
	BUTTON "OK"				ID kpdOk		AT (5 134 71 16)
	BUTTON "Cancel"			ID kpdCancel	AT (80 134 71 16)
END

