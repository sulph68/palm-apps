		MENUITEM "Kes"					ID 10001 "X"
		MENUITEM "Kopyala"				ID 10002 "C"
		MENUITEM "Yapýþtýr"				ID 10003 "P"
		MENUITEM "Tümünü Seç"			ID 10004 "S"
		MENUITEM SEPARATOR
		MENUITEM "Klavye"				ID 10006 "K"
		MENUITEM "Graffiti"				ID 10007	"G"
	END

