FORM ID frmPrefsForm AT (2 14 156 144)
FRAME MODAL
HELPID strPrefsHelpString
BEGIN
	TITLE "Not tercihleriniz"
	LABEL "Sýralama:"				AUTOID					AT (8 16) FONT 0
	POPUPTRIGGER ""					ID popPrefsSortOrder 	AT (50 PrevTop 70 13)
									LEFTANCHOR
	LIST "El ile" "Alfabetik"		ID lstPrefsSortOrder   	AT (PrevLeft PrevTop 70 1)
									VISIBLEITEMS 2 NONUSABLE
	POPUPLIST popPrefsSortOrder lstPrefsSortOrder
	LABEL "Notlarý yukarý taþý"		AUTOID				AT (24 30) FONT 0
	CHECKBOX ""				ID chkPrefsMoveRecordOnTop AT (5  PrevTop AUTO AUTO)
	LABEL "Çizgileri göster"		AUTOID					AT (24 41) FONT 0
	CHECKBOX ""						ID chkPrefsShowLines 	AT (5 PrevTop AUTO AUTO)
	LABEL "Tek font kullan"			AUTOID					AT (24 52) FONT 0
	CHECKBOX ""						ID chkPrefsUseSingleFont AT (5 PrevTop AUTO AUTO)
	LABEL "Dönüþüm alaný:"		AUTOID				AT (8 63) FONT 0
	POPUPTRIGGER ""			ID popPrefsRotateOrder AT (78 PrevTop 70 13)
							LEFTANCHOR
	LIST "All" "All-Unfiled" "Categ.-Unfiled"
							ID lstPrefsRotateOrder   AT (78 PrevTop PrevWidth 1)
							VISIBLEITEMS 3  NONUSABLE
	LABEL "Genel Parola Özellikleri:"		AUTOID				AT (16 78) FONT 1
	LABEL "Genel Parola:"			AUTOID					AT (7 92) FONT 0
	SELECTORTRIGGER "-Atanmamýþ-"	ID selPrefsGlobalPassword AT (64 PrevTop AUTO AUTO)
							LEFTANCHOR
	BUTTON "Parola Unutulduysa..."	ID btnPrefsForgotten	AT (20 108 112 AUTO)
	BUTTON "Tamam"					ID btnPrefsOK			AT (6 126 38 AUTO)
	BUTTON "Vazgeç"					ID btnPrefsCancel		AT (PrevRight+6 PrevTop 38 AUTO)
END

STRING ID strPrefsHelpString 	"• El ile sýralama notlarýn " \
					"liste üzerinde kalemcikle "\
					"tutulup aþaðý ya da yukarý " \
					"sürüklenerek istenilen sýrada " \
					"býrakýlmasý ile yapýlýr.\n" \
					"\n" \
					"• Alfabetik sýralama " \
					"notlarý alfabetik olarak " \
					"sýralayacak ve bu önceki " \
					"sýralamayý bozacaktýr.\n" \
					"\n" \
					"•  Notlarý yukarý taþý, " \
					"her eriþilen notu listenin " \
					"en üstüne taþýr.\n" \ 
					"\n" \
					"• Çizgileri göster, not " \
					"deðiþtirme ekranýnda satýr " \
					"çizgilerinin gözüküp " \ 
					"gözükmemesini belirler.\n" \
					"\n" \
					"• Tek font kullan seçili ise " \
					"bütün notlarda ve ana listedeki " \
					"tüm kategorilerde ayný font " \
					"kullanýlacaktýr.\n" \
					"\n" \
					"• Dönüþüm alaný; not " \
					"defteri tuþuna basýldýðýnda " \
					"kullanýcýnýn hangi " \
					"kategorilerin görüleceðini " \
					"seçmesine yarar. \"All-Unfiled\" " \
					"\"Unfiled\" kategorisine " \
					"giderken, \"Categ.-Unfiled\" " \
					"\"All\" kategorisini atlar.\n" \
					"\n" \
					"• Genel parola tüm yeni " \
					"þifrelenecek notlar için " \
					"ortak bir parola atamanýza " \
					"yarar."

