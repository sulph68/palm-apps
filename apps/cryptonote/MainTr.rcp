MENU ID mnuMainMenu
BEGIN
	PULLDOWN "Kayýt"
	BEGIN
		MENUITEM "Kategoriyi Iþýnla"			ID itemRecordBeamCategory
		MENUITEM SEPARATOR
		MENUITEM "Kategoriyi Þifrele..."		ID itemRecordEncryptCategory
		MENUITEM "Kategorinin Þifresini kaldýr..."		ID itemRecordDecryptCategory
	END

	PULLDOWN "Seçenekler"
	BEGIN
		MENUITEM "Font..."			ID itemOptionsFont "F"
		MENUITEM "Tercihler..."	ID itemOptionsPrefs "R"
		MENUITEM "CryptoPad Hakkýnda" 	ID itemOptionsAbout
	END
END

MENU ID mnuEditMenu
