ICON "appico.bmp"
SMALLICON "smallico.bmp"

VERSION ID 1 "3.65"

FORM ID frmMainForm AT (0 0 160 160)
NOFRAME
MENUID mnuMainMenu
BEGIN
	TITLE "CryptoPad"
	POPUPTRIGGER ""			ID popMainCategory   AT (90 0 70 13)
							RIGHTANCHOR
	LIST ""					ID lstMainCategory   AT (PrevLeft 1 PrevWidth 1)
							VISIBLEITEMS 5 NONUSABLE
	POPUPLIST				ID popMainCategory lstMainCategory
	TABLE					ID tblMainRecordList AT (0 18 152 124)
							ROWS 11 COLUMNS 1
							COLUMNWIDTHS 151
	SCROLLBAR				ID sclMainScrollBar  AT (153 PrevTop 7 121)
							VALUE 0 MIN 0 MAX 10 PAGESIZE 10 
	BUTTON "Nuevo"			ID btnMainNewMemo    AT (1 147 34 12) 
END

FORM ID frmProgressForm AT (2 78 156 80)
FRAME MODAL
BEGIN
	TITLE "Progreso"
	GADGET 					ID gadProgressMessage AT (10 25 140 15) 
	GADGET 					ID gadProgressBar AT (10 52 140 7)  
END

FORM ID frmEditForm AT (0 0 160 160)
NOFRAME
MENUID mnuEditMenu
BEGIN
	TITLE "Memo"
	SELECTORTRIGGER ""		ID popEditCategory   AT (89 1 70 11)
							RIGHTANCHOR
	LIST ""					ID lstEditCategory   AT (PrevLeft PrevTop PrevWidth 1)
							VISIBLEITEMS 5 NONUSABLE
	POPUPLIST				ID popEditCategory lstEditCategory
	FIELD					ID fldEditText       AT (0 16 153 125)
							MULTIPLELINES UNDERLINED HASSCROLLBAR
							AUTOSHIFT MAXCHARS 65000
	SCROLLBAR				ID sclEditScrollBar  AT (153 18 7 121)
							VALUE 0 MIN 0 MAX 10 PAGESIZE 10
	LABEL ">4k"				ID lblEditMaxSize	AT (145 148 ) FONT 0 NONUSABLE
	BUTTON "Listo"			ID btnEditTerminate  AT (1 147 38 12)
	BUTTON "Detalles"		ID btnEditDetails    AT (45 PrevTop 40 12)
	GRAFFITISTATEINDICATOR	                     AT (135 PrevTop)
END

STRING ID	strEditTitleMemo "Memo # de "

FORM ID frmDetailsForm AT (2 86 156 72)
FRAME MODAL
HELPID strDetailsHelpString
BEGIN
	TITLE "Detalles Memo"
	LABEL "Categoría:"	AUTOID				AT (5 18) FONT 1
	POPUPTRIGGER ""			ID popDetailsCategory AT (57 PrevTop 70 13)
							LEFTANCHOR
	LIST ""					ID lstDetailsCategory   AT (57 PrevTop 70 1)
							VISIBLEITEMS 5 NONUSABLE
	POPUPLIST				ID popDetailsCategory lstDetailsCategory
	LABEL "Privado:"		AUTOID              AT (13 32) FONT 1
	CHECKBOX ""				ID chkDetailsPrivate AT (58 32 AUTO AUTO)
	BUTTON "OK"				ID btnDetailsOK		AT (6 54 38 AUTO)
	BUTTON "Cancelar"			ID btnDetailsCancel	AT (PrevRight+6 PrevTop 40 AUTO)
	BUTTON "Borrar..."		ID btnDetailsDelete	AT (PrevRight+6 PrevTop 40 AUTO)
END

STRING ID strDetailsHelpString "• La categoría desplegada " \
					"en la Lista de Memos es " \
					"asignada automáticamente a " \
					"nuevos Memos\n" \
					"\n" \
					"• Hay dos maneras de cambiar " \
					"la categoría de un memo:\n" \
					"\n" \
					"1. Selecionando una nueva " \
					"categoría en el diálogo de " \
					"Detalles Memo.\n" \
					"2. En la vista de edición del " \
					"memo, escogiendo una nueva " \
					"categoría de la lista."

FORM ID frmPasswordForm AT (2 75 156 83)
FRAME MODAL
HELPID strPasswordHelpString
BEGIN
	TITLE "Clave"
	FORMBITMAP 	AT (5 20) BITMAP 10005
	LABEL "Ingrese una clave:"		AUTOID			AT (30 PrevTop) FONT 1
	FIELD					ID fldPasswordText		 AT (5 42 146 13)
							SINGLELINE UNDERLINED
							MAXCHARS 56
	BUTTON "OK"				ID btnPasswordOK		 AT (6 65 32 AUTO)
	BUTTON "Cancelar"		ID btnPasswordCancel	 AT (PrevRight+6 PrevTop 40 AUTO)
	BUTTON "Olvidar..."		ID btnPasswordForget	 AT (PrevRight+6 PrevTop AUTO AUTO)
	GRAFFITISTATEINDICATOR	                         AT (144 PrevTop)
END

STRING ID strPasswordHelpString "• Ingrese una clave para encriptar " \
					"el memo.\n" \
					"\n" \
					"• La clave se usará para encripción y " \
					"decripción. Asegúrese de no olvidarla, " \
					"ya que es imposible recuperar los contenidos " \
					"de los memos encriptados con esta clave."

FORM ID frmQueryGlobalPasswordForm AT (2 67 156 91)
FRAME MODAL
BEGIN
	TITLE "Clave Global"
	FORMBITMAP 	AT (5 20) BITMAP 10005
	LABEL "Ingrese su actual"		AUTOID			AT (30 PrevTop) FONT 1
	LABEL "clave global:"		AUTOID			AT (PrevLeft 32) FONT 1
	FIELD					ID fldQueryGlobalPasswordText		 AT (5 50 146 13)
							SINGLELINE UNDERLINED
							MAXCHARS 56
	BUTTON "OK"				ID btnQueryGlobalPasswordOK		 AT (6 73 38 AUTO)
	BUTTON "Cancelar"			ID btnQueryGlobalPasswordCancel	 AT (PrevRight+6 PrevTop 40 AUTO)
	GRAFFITISTATEINDICATOR	                         AT (144 PrevTop)
END

FORM ID frmConfirmGlobalPasswordForm AT (2 20 156 138)
FRAME MODAL
BEGIN
	TITLE "Clave Global"
	LABEL "Verifique su nueva clave:"		AUTOID			AT (5 16) FONT 1
	FIELD					ID fldSetAndChangeGlobalPasswordText		 AT (PrevLeft 32 146 13)
							SINGLELINE UNDERLINED
							MAXCHARS 56
	LABEL "Si olvida esta clave puede"		AUTOID			AT (PrevLeft 52)
 FONT 1
	LABEL "tocar \"Clave Olvidada...\""		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
 	LABEL " para borrarla, pero todos"		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
  	LABEL "los registros encriptados con"		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
  	LABEL "la clave global se borrarán."		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
	BUTTON "OK"				ID btnConfirmGlobalPasswordOK		 AT (6 120 38 AUTO)
	BUTTON "Cancelar"			ID btnSetAndChangeGlobalPasswordCancel	 AT (PrevRight+6 PrevTop 40 AUTO)
	GRAFFITISTATEINDICATOR	                         AT (144 PrevTop)
END

FORM ID frmSetGlobalPasswordForm AT (2 20 156 138)
FRAME MODAL
HELPID strSetGlobalPasswordHelpString
BEGIN
	TITLE "Clave Global"
	LABEL "Ingrese una clave:"		AUTOID			AT (5 16) FONT 1
	FIELD					ID fldSetAndChangeGlobalPasswordText		 AT (PrevLeft 32 146 13)
							SINGLELINE UNDERLINED
							MAXCHARS 56
	LABEL "Si asigna una clave, deberá"		AUTOID			AT (PrevLeft 52)
 FONT 1
	LABEL "ingresarla para mostrar los"		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
 	LABEL "registros encriptados. Desde "		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
  	LABEL "ahora, los registros encripta-"		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
  	LABEL "dos usarán la clave global."		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
	BUTTON "OK"				ID btnSetAndChangeGlobalPasswordOK		 AT (6 120 38 AUTO)
	BUTTON "Cancelar"			ID btnSetAndChangeGlobalPasswordCancel	 AT (PrevRight+6 PrevTop 40 AUTO)
	GRAFFITISTATEINDICATOR	                         AT (144 PrevTop)
END

STRING ID strSetGlobalPasswordHelpString "• Ingrese una clave para configurar " \
					"como clave global.\n" \
					"\n" \
					"• Esta clave global se transformará en la " \
					"clave actual, y se usará para encripción y " \
					"decripción. Asegúrese de no olvidarla, " \
					"ya que es imposible recuperar los contenidos " \
					"de los memos encriptados con esta clave."


FORM ID frmChangeGlobalPasswordForm AT (2 61 156 97)
FRAME MODAL
HELPID strSetGlobalPasswordHelpString
BEGIN
	TITLE "Cambiar Clave Global"
	LABEL "Ingrese la nueva clave o toque"		AUTOID			AT (5 16)
 FONT 1
	LABEL "el botón Borrar para remover"		AUTOID			AT (PrevLeft 28)
 FONT 1
 	LABEL "su clave actual."		AUTOID			AT (PrevLeft PrevTop+12)
 FONT 1
	FIELD					ID fldSetAndChangeGlobalPasswordText		 AT (5 56 146 13)
							SINGLELINE UNDERLINED
							MAXCHARS 56
	BUTTON "OK"				ID btnSetAndChangeGlobalPasswordOK		 AT (6 79 38 AUTO)
	BUTTON "Cancelar"			ID btnSetAndChangeGlobalPasswordCancel	 AT (PrevRight+6 PrevTop 40 AUTO)
	BUTTON "Borrar"			ID btnChangeGlobalPasswordDelete	 AT (PrevRight+6 PrevTop 40 AUTO)
	GRAFFITISTATEINDICATOR	                         AT (144 PrevTop)
END

FORM ID frmPrefsForm AT (2 14 156 144)
FRAME MODAL
HELPID strPrefsHelpString
BEGIN
	TITLE "Preferencias para Memos"
	LABEL "Ordenar por:"		AUTOID				AT (8 16) FONT 0
	POPUPTRIGGER ""			ID popPrefsSortOrder AT (64 PrevTop 70 13)
							LEFTANCHOR
	LIST "Manualmente" "Alfabéticamente"
							ID lstPrefsSortOrder   AT (PrevLeft PrevTop 70 1)
							VISIBLEITEMS 2 NONUSABLE
	POPUPLIST				popPrefsSortOrder lstPrefsSortOrder
	LABEL "Mover Primer Registro"		AUTOID				AT (24 30) FONT 0
	CHECKBOX ""				ID chkPrefsMoveRecordOnTop AT (5  PrevTop AUTO AUTO)
	LABEL "Mostrar Líneas"		AUTOID				AT (24 41) FONT 0
	CHECKBOX ""				ID chkPrefsShowLines AT (5 PrevTop AUTO AUTO)
	LABEL "Utilizar una sóla fuente"		AUTOID				AT (24 52) FONT 0
	CHECKBOX ""				ID chkPrefsUseSingleFont AT (5 PrevTop AUTO AUTO)
	LABEL "Mover por Categorías:"		AUTOID				AT (8 63) FONT 0
	POPUPTRIGGER ""			ID popPrefsRotateOrder AT (100 PrevTop 90 13)
							LEFTANCHOR
	LIST "Todo" "Todo-Sin Clasificar" "Categ.-Sin Clasificar"
							ID lstPrefsRotateOrder   AT (PrevLeft PrevTop PrevWidth 1)
							VISIBLEITEMS 3  NONUSABLE
	LABEL "Preferencias de Clave Global:"		AUTOID				AT (7 78) FONT 1
	LABEL "Clave Global:"		AUTOID				AT (7 92) FONT 0
	SELECTORTRIGGER "-No Asignada-"		ID selPrefsGlobalPassword AT (64 PrevTop AUTO AUTO)
							LEFTANCHOR
	BUTTON "Clave Olvidada..."				ID btnPrefsForgotten		AT (20 108 112 AUTO)
	BUTTON "OK"				ID btnPrefsOK		AT (6 126 38 AUTO)
	BUTTON "Cancelar"			ID btnPrefsCancel	AT (PrevRight+6 PrevTop 40 AUTO)
END

STRING ID strPrefsHelpString 	"• Ordenar Manualmente permite " \
							"realizar un ordenamiento manual "\
							"de los memos, arrastrándolos por la " \
							"lista. Para arrastrar, toque un memo, " \
							"arrástrelo a la posición deseada y " \
							"levante el estilete.\n" \
							"\n" \
							"• Ordenar Alfabéticamente ordena los " \
							"memos alfabéticamente. Este ordenamiento " \
							"eliminará el ordenamiento actual.\n" \
							"\n" \
							"• Mover Primer Registro mueve cada memo " \
							"examinado al tope de la lista.\n" \
							"\n" \
							"• Mostrar Líneas permite mostrar o " \
							"esconder el subrayado en la forma de " \
							"edición de memos.\n" \
							"\n" \
							"• Utilizar una sóla fuente permite " \
							"usar una fuente independiente para " \
							"cada memo en la vista de edición " \
							"y para cada categoría en la vista " \
							"principal.\n" \
							"\n" \
							"•  Mover por Categorías permite " \
							"al usuario escoger qué categorías " \
							" se despliegan cuando se oprime el " \
							"botón de la aplicación para cambiar " \
							"categorías. \"Todo-Sin Clasificar\" " \
							"aparece también en la categoría " \
							"\"Sin Clasificar\", y \"Categ.-Sin " \
							"Clasificar\" se salta la categoría " \
							"\"Todo\".\n" \
							"\n" \
							"• Clave Global permite al usuario " \
							"asignar una clave global para todos " \
							"los memos nuevos encriptados."

FORM ID frmDeleteForm AT (2 72 156 86)
FRAME MODAL
HELPID strDeleteHelpString
BEGIN
	TITLE "Borrar Memo"
	FORMBITMAP 	AT (5 20) BITMAP 10005
	LABEL "Borrar memo actual?"		AUTOID		AT (30 20) FONT 1
	CHECKBOX ""				ID chkDeleteBackup AT (8 45 AUTO AUTO)
	LABEL "Guardar Respaldo en PC"		AUTOID		AT (28 PrevTop) FONT 1
	BUTTON "OK"				ID btnDeleteOK		AT (5 68 38 AUTO)
	BUTTON "Cancelar"			ID btnDeleteCancel	AT (PrevRight+6 PrevTop AUTO AUTO)
END

STRING ID strDeleteHelpString	"La opción Guardar Respaldo en PC " \
								"guardará los registros eliminados " \
								"en un archivo de respaldo en su " \
								"computador durante el próximo Hotsynch. " \
								"Algunos registros se esconderán " \
								"pero no serán borrados hasta entonces."


FORM ID frmAboutForm AT (2 36 156 122)
FRAME MODAL
HELPID strAboutHelpString
BEGIN
	TITLE "Acerca de CryptoPad"
	FORMBITMAP AT (5 17) BITMAP bmpCryptoPadIcon
	LABEL "v. 3.65"					AUTOID AT (32 16) FONT 1
	LABEL "Maxime & JB Labelle"			AUTOID AT (PrevLeft 27) FONT 1
	LABEL "http://cryptopad.sourceforge.net/"	AUTOID AT (5 50)
	LABEL "Contiene software criptográfico"		AUTOID AT (PrevLeft PrevTop+15)
	LABEL "escrito por Eric Young."			AUTOID AT (PrevLeft PrevTop+11)
	BUTTON "OK" AUTOID AT (60 104 40 AUTO)
END

STRING ID strAboutHelpString	"Crypto-Pad es una version mejorada " \
								"del MemoPad. Sugerimos que visite " \
								"nuestro website o www.palmgear.com " \
								"de vez en cuando para encontrar " \
								"nuevas versiones.\n" \
								"\n" \
								"Tenga en cuenta que cuando se transmite " \
								"un memo, el receptor debe salir de " \
								"CryptoPad para poder recibirlo."


MENU ID mnuMainMenu
BEGIN
	PULLDOWN "Registro"
	BEGIN
		MENUITEM "Transimitr Categoria"			ID itemRecordBeamCategory
		MENUITEM SEPARATOR
		MENUITEM "Encriptar Categoría..."		ID itemRecordEncryptCategory
		MENUITEM "Decriptar Categoría..."		ID itemRecordDecryptCategory
	END

	PULLDOWN "Opciones"
	BEGIN
		MENUITEM "Letra..."			ID itemOptionsFont "L"
		MENUITEM "Preferencias..."		ID itemOptionsPrefs "P"
		MENUITEM "Acerca de CryptoPad" 	ID itemOptionsAbout
	END
END

MENU ID mnuEditMenu
BEGIN
	PULLDOWN "Registro"
	BEGIN
		MENUITEM "Nuevo Memo"			ID itemRecordNewMemo	"N"
		MENUITEM "Borrar Memo..."		ID itemRecordDeleteMemo	"B"
		MENUITEM "Transimitir Memo"			ID itemRecordBeamMemo	"M"
		MENUITEM SEPARATOR
		MENUITEM "Encriptar Memo..."		ID itemRecordEncryptMemo "E"
	END

	PULLDOWN "Edición"
	BEGIN
		MENUITEM "Deshacer"				ID 10000 "Z"
		MENUITEM "Cortar"				ID 10001 "X"
		MENUITEM "Copiar"				ID 10002 "C"
		MENUITEM "Pegar"				ID 10003 "V"
		MENUITEM "Seleccionar Todo"		ID 10004 "S"
		MENUITEM SEPARATOR
		MENUITEM "Teclado"				ID 10006 "T"
		MENUITEM "Graffiti"				ID 10007	"G"
	END

	PULLDOWN "Opciones"
	BEGIN
		MENUITEM "Letra..."				ID itemOptionsFont "L"
		MENUITEM "Ir a Inicio de Página" 	ID itemOptionsGoTopOfPage
		MENUITEM "Ir a Fin de Página"	ID itemOptionsGoBottomOfPage
		MENUITEM "Buscar Teléfono" 		ID itemOptionsPhoneLookup "F"
		MENUITEM "Acerca de CryptoPad" 	ID itemOptionsAbout
	END
END

MENU ID mnuEditMenuNoPwd
BEGIN
	PULLDOWN "Registro"
	BEGIN
		MENUITEM "Nuevo Memo"			ID itemRecordNewMemo	"N"
		MENUITEM "Borrar Memo..."		ID itemRecordDeleteMemo	"B"
		MENUITEM "Transimitir Memo"		ID itemRecordBeamMemo	"M"
		MENUITEM SEPARATOR
		MENUITEM "Eliminar Clave"		ID itemRecordRemovePasswd "E"
	END

	PULLDOWN "Edición"
	BEGIN
		MENUITEM "Deshacer"				ID 10000 "Z"
		MENUITEM "Cortar"				ID 10001 "X"
		MENUITEM "Copiar"				ID 10002 "C"
		MENUITEM "Pegar"				ID 10003 "V"
		MENUITEM "Seleccionar Todo"		ID 10004 "S"
		MENUITEM SEPARATOR
		MENUITEM "Teclado"				ID 10006 "T"
		MENUITEM "Graffiti"				ID 10007 "G"
	END

	PULLDOWN "Opciones"
	BEGIN
		MENUITEM "Letra..."				ID itemOptionsFont "L"
		MENUITEM "Ir a Inicio de Página" 	ID itemOptionsGoTopOfPage
		MENUITEM "Ir a Fin de Página"	ID itemOptionsGoBottomOfPage
		MENUITEM "Buscar Teléfono" 		ID itemOptionsPhoneLookup "F"
		MENUITEM "Acerca de CryptoPad" 	ID itemOptionsAbout
	END
END

BITMAP ID bmpCryptoPadIcon "icon.bmp"
BITMAP ID bmpMainKeyBitmap "key.bmp"
BITMAP ID bmpBarFontBitmap "font.bmp"
BITMAP ID bmpBarPhoneBitmap "phone.bmp"

STRING strCryptoHeader "CryptoPad"
STRING strBeamDescription "memo"
STRING strBeamFilename "memo.TXT"

STRING strMenuSecurityItem "Seguridad..."
STRING strSynchroniseFont "Letra prefiere"

STRING strGlobalPasswordUnassigned "-No Asignada-"
STRING strGlobalPasswordAssigned "-Asignada-"

STRING strProgressEncryption "Encripción de Categoría"
STRING strProgressDecryption "Decripción de Categoría"


ALERT ID altConfirmDeleteAlert
CONFIRMATION
BEGIN
	TITLE "Borrar Memo"
	MESSAGE "Borrar este memo?"
	BUTTONS "OK" "Cancelar"
END

ALERT ID altInvalidPasswordAlert
ERROR
BEGIN
	TITLE "Clave"
	MESSAGE "Clave incorrecta.\nIntente nuevamente."
	BUTTONS "OK"
END

ALERT ID altGlobalPasswordNotMatchAlert
INFORMATION
BEGIN
	TITLE "Clave Global"
	MESSAGE "Clave global incorrecta.\nIntente nuevamente."
	BUTTONS "OK"
END

ALERT ID altConfirmDeleteForgottenPasswordAlert
INFORMATION
BEGIN
	TITLE "Clave Global"
	MESSAGE "Al borrar una clave olvidada, se borrarán todos los registros " \
			"encriptados con la clave global. ¿Desea proceder?"
	BUTTONS "Sí" "No"
END

ALERT ID altNoGlobalPasswordToDeleteAlert
ERROR
HELPID strDeleteForgottenPassword
BEGIN
	TITLE "Borrar Clave Global"
	MESSAGE "No existe una clave global para borrar."
	BUTTONS "OK"
END

STRING ID strDeleteForgottenPassword "Esta opción le permite borrar una clave global " \
				"olvidada.\nTodos los registros previamente encriptados con la clave global " \
				"son borrados."

ALERT ID altInvalidGlobalPasswordAlert
ERROR
BEGIN
	TITLE "Clave Global"
	MESSAGE "Clave global incorrecta.\nIntente nuevamente."
	BUTTONS "OK"
END

ALERT ID altUseNoGlobalPasswordAlert
INFORMATION
BEGIN
	TITLE "Clave"
	MESSAGE "Este registro no fue encriptado con la clave global.\n" \
			"Intente nuevamente con otra clave."
	BUTTONS "OK"
END

ALERT ID altEncryptRecordWithGlobalPasswordAlert
INFORMATION
BEGIN
	TITLE "Encriptar Registro"
	MESSAGE "El registro actual será encriptado con la clave global."
	BUTTONS "OK"
END

ALERT ID altEncryptCategoryWithGlobalPasswordAlert
INFORMATION
BEGIN
	TITLE "Encriptar Categoría"
	MESSAGE "La categoría actual será encriptada con la clave global."
	BUTTONS "OK"
END

ALERT ID altCategoryAlreadyEncryptedAlert
INFORMATION
BEGIN
	TITLE "Encriptar Categoría"
	MESSAGE "La categoría actual ya está encriptada."
	BUTTONS "OK"
END

ALERT ID altCategoryAlreadyDecryptedAlert
INFORMATION
BEGIN
	TITLE "Decriptar Categoría"
	MESSAGE "La categoría actual ya está decriptada."
	BUTTONS "OK"
END

ALERT ID altInvalidFormatAlert
ERROR
BEGIN
	TITLE "Error de Encripción"
	MESSAGE "El memo debe contener al menos dos líneas."
	BUTTONS "OK"
END

ALERT ID altRemovePasswdAlert
INFORMATION
BEGIN
	TITLE "Clave"
	MESSAGE "El memo ya no tiene protección de clave."
	BUTTONS "OK"
END

ALERT ID altAlphabeticSortAlert
INFORMATION
BEGIN
	TITLE "Ordenamiento Alfabético"
	MESSAGE "El ordenamiento actual se perderá si los memos son ordenados " \
			"alfabéticamente. ¿Está seguro de que desea ordenar los memos?"
	BUTTONS "OK" "Cancelar"
END

ALERT ID altRomIncompatibleAlert
ERROR
BEGIN
	TITLE "Versión de ROM"
	MESSAGE "Se requiere una versión de ROM 3.0 ó superior para que este programa funcione correctamente."
	BUTTONS "OK"
END

ALERT ID altUseSingleFontAlert
INFORMATION
BEGIN
	TITLE "Utiolizar una sóla fuente"
	MESSAGE "El uso de fuentes independientes se perderá si usted prefiere usar una " \
			"sóla fuente. Está seguro de que desea utilizar una sóla fuente ?"
	BUTTONS "OK" "Cancelar"
END

ALERT ID altMoveRecordOnTopImpossibleAlert
INFORMATION
BEGIN
	TITLE "Mover Primer Registro"
	MESSAGE "Ud. debe seleccionar el ordenamiento en Manual para utilizar " \
			"\"Mover Primer Registro\"."
	BUTTONS "OK"
END

ALERT ID altChangeTableFontOfCategoryAllAlert
INFORMATION
BEGIN
	TITLE "Fuente"
	MESSAGE "Usted está utilizando fuentes independientes para las categorías, entonces no se puede cambiar la fuente para la categoria Todos.\n" \
	"Seleccione una categoría antes de utilizar el comando Fuente."
	BUTTONS "OK"
END

ALERT ID altBeamCryptoDataAlert
INFORMATION
BEGIN
	TITLE "Beam"
	MESSAGE "No se puede transmitir un memo encriptado. "
	BUTTONS "OK"
END


ALERT ID altDebugAlert
BEGIN
	TITLE "Alerta de Debug"
	MESSAGE "^1"
	BUTTONS "OK"
END
