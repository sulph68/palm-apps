// aboutdb35.rcp - Db35 custom full-screen About form (replaces ROM AbtShowAbout).
FORM ID 8800 AT (2 2 156 156) MODAL FRAME
USABLE
BEGIN
  TITLE "About Datebook35"
  LABEL "Datebook35" ID 8801 AT (12 30) FONT 1
  LABEL "v. 1.0" ID 8802 AT (12 46)
  LABEL "Extended Datebook v3.5 (2026)\rfrom example source.\rSupport dates beyond 2031." ID 8803 AT (12 70) FONT 0
  BUTTON "OK" ID 8806 AT (58 138 40 12)
END

// Db35: custom (not ALERT) -- a native ALERT auto-sizes its buttons from label
// text with no width override, so this needs a real FORM for the specific
// button geometry. Same geometry as ToDo35's DuplicateRepeatDlg: full app
// width (x=2 w=156), bottom-aligned (y=66 h=92, bottom=158), buttons evenly
// spaced 5px from each border and 5px between buttons (45/45/46 to land the
// right margin exactly on 5px). Message is hand-drawn bold + word-wrapped
// (dynamic text) by C, not a LABEL.
FORM ID 2300 AT (2 66 156 92) MODAL
BEGIN
  TITLE "Duplicate Event"
  BUTTON "This Only"	ID 2301	AT (5 74 45 12)
  BUTTON "All"			ID 2302	AT (55 74 45 12)
  BUTTON "Cancel"		ID 2303	AT (105 74 46 12)
END
