// Db35: full-screen (2 2 156 156) per user request -- was (2 11 156 147),
// bottom-anchored the same as it's always been (2+156 = 11+147 = 158).
// Title grew from 1 line to 2 (11px -> 22px tall); every row below it
// shifted down using this app's established row-spacing convention (16px
// pitch between single-line rows, +12px extra after any 2-line field --
// same math Location's own insertion already used for the Repeat row below
// it). x-positions are untouched except where noted (Title's were already
// user-tuned last round).
FORM ID 1300 AT (2 2 156 156)
MODAL
MENUID 1324
BEGIN
  TITLE "Event  Details"
  LABEL "Title:" ID 1322 AT (21 18) FONT 1
  FIELD ID 1323 AT (53 18 100 22) EDITABLE UNDERLINED MULTIPLELINES MAXCHARS 254
  // Db35: "Start:"/"End:" replace the old combined "Time:" (ROM SelectTime
  // start+end trigger) and "Date:" (start-date-only) rows, same two
  // row-slots -- each shows a single combined "7:30pm Fri 11/12/2035"-style
  // moment; tapping opens DateSpan.c's "Set Date & Time" sub-dialog, letting
  // End land on a later day (an event spanning midnight, e.g. a flight).
  LABEL "Start:" ID 1302 AT (17 46) FONT 1
  SELECTORTRIGGER "12:00pm Wed 12/31/2035                  " ID 1303 AT (53 46 100 11)
  LABEL "End:" ID 1304 AT (29 62) FONT 1
  SELECTORTRIGGER "12:00pm Wed 12/31/2035                  " ID 1305 AT (53 62 100 11)
  LABEL "Location:" ID 1320 AT (2 78) FONT 1
  FIELD ID 1321 AT (53 78 100 22) EDITABLE UNDERLINED MULTIPLELINES MAXCHARS 63
  LABEL "Repeat:" ID 1312 AT (8 106) FONT 1
  SELECTORTRIGGER "None                                    " ID 1313 AT (53 106 80 11)
  LABEL "Private:" ID 1314 AT (7 122) FONT 1
  CHECKBOX "" ID 1315 AT (50 121 14 14)
  BUTTON "OK" ID 1316 AT (5 140 25 12)
  BUTTON "Cancel" ID 1317 AT (36 140 35 12)
  BUTTON "Delete..." ID 1318 AT (77 140 40 12)
  BUTTON "Note" ID 1319 AT (123 140 28 12)
END

// Db35: shared by Event Details' Start:/End: rows (DateSpan.c) -- "Date:"
// opens the era day picker, "Time:" opens the ROM's single-moment picker
// (SelectOneTime); "No Time" only shown when editing Start (a
// whole-appointment property, see DateSpan.c). Title is set at runtime
// (FrmSetTitle, "Start"/"End") -- the text here is just the resource default.
FORM ID 1360 AT (2 88 156 70)
MODAL
BEGIN
  TITLE "Date & Time"
  LABEL "Date:" ID 1366 AT (10 19) FONT 1
  SELECTORTRIGGER "DAY MM/DD/YY+7debug                     " ID 1361 AT (46 19 100 11)
  LABEL "Time:" ID 1367 AT (10 36) FONT 1
  SELECTORTRIGGER "12:00 pm                                " ID 1362 AT (46 36 54 11)
  CHECKBOX "No Time" ID 1363 AT (96 36 52 12)
  BUTTON "OK" ID 1364 AT (10 54 37 12)
  BUTTON "Cancel" ID 1365 AT (53 54 44 12)
END

// "End date must be..." rejection when the picked End date falls outside
// [start date, start date + 30] -- DateSpan.c re-loops back to the picker.
ALERT ID 1370	// altSpanOutOfRange
INFORMATION
BEGIN
  TITLE "Invalid Date"
  MESSAGE "The end date must be on or after the start date, and no more than 30 days after it."
  BUTTONS "OK"
END

// Db35: CalDAV Sync event row info - read-only, no separate app view to
// switch to, so tapping one just shows its own full text.
ALERT ID 1371	// altDavInfo
INFORMATION
BEGIN
  TITLE "Calendar Event"
  MESSAGE "^1"
  BUTTONS "OK"
END

// Db35: shown from DetailsHandleEvent when the user actually tries to
// change a CalDAV item (see altDavReadOnly's own header comment).
ALERT ID 1372	// altDavReadOnly
INFORMATION
BEGIN
  TITLE "Read-Only"
  MESSAGE "CalDAV events are read-only."
  BUTTONS "OK"
END

FORM ID 1400 AT (2 2 156 156)
MODAL
BEGIN
  TITLE "Change Repeat"
  PUSHBUTTON "None" ID 1402 AT (7 20 26 11) GROUP 1
  PUSHBUTTON "Day" ID 1403 AT (34 20 23 11) GROUP 1
  PUSHBUTTON "Week" ID 1404 AT (58 20 30 11) GROUP 1
  PUSHBUTTON "Month" ID 1405 AT (89 20 32 11) GROUP 1
  PUSHBUTTON "Year" ID 1406 AT (122 20 25 11) GROUP 1
  LABEL "Every:" ID 1407 AT (24 38) FONT 1 NONUSABLE
  FIELD ID 1408 AT (60 38 17 11) MAXCHARS 80 NONUSABLE
  LABEL "Day(s)" ID 1409 AT (83 38) FONT 1 NONUSABLE
  LABEL "Week(s)" ID 1410 AT (83 38) FONT 1 NONUSABLE
  LABEL "Month(s)" ID 1411 AT (83 38) FONT 1 NONUSABLE
  LABEL "Year(s)" ID 1412 AT (83 38) FONT 1 NONUSABLE
  LABEL "End on:" ID 1413 AT (21 55) FONT 1 NONUSABLE
  POPUPTRIGGER "**19 bytes**........                    " ID 1415 AT (60 55 1 13) NONUSABLE
  LIST "No End Date" "Choose Date..." ID 1416 AT (60 58 70 1) VISIBLEITEMS 2 NONUSABLE
  LABEL "Repeat on:" ID 1417 AT (5 72) FONT 1 NONUSABLE
  PUSHBUTTON "S" ID 1418 AT (63 72 10 12) NONUSABLE
  PUSHBUTTON "M" ID 1419 AT (74 72 10 12) NONUSABLE
  PUSHBUTTON "T" ID 1420 AT (85 72 10 12) NONUSABLE
  PUSHBUTTON "W" ID 1421 AT (96 72 10 12) NONUSABLE
  PUSHBUTTON "T" ID 1422 AT (107 72 10 12) NONUSABLE
  PUSHBUTTON "F" ID 1423 AT (118 72 10 12) NONUSABLE
  PUSHBUTTON "S" ID 1424 AT (129 72 10 12) NONUSABLE
  LABEL "Repeat by:" ID 1425 AT (5 72) FONT 1 NONUSABLE
  PUSHBUTTON "Day" ID 1426 AT (63 72 40 12) GROUP 2 NONUSABLE
  PUSHBUTTON "Date" ID 1427 AT (104 72 40 12) GROUP 2 NONUSABLE
  GADGET ID 1440 AT (3 90 150 45)
  FIELD ID 1428 AT (10 100 136 22) MAXCHARS 80
  LABEL "Tap one of the above\rbuttons to set a repeat\rinterval." ID 1429 AT (7 38) FONT 1 NONUSABLE
  BUTTON "OK" ID 1430 AT (4 140 25 12)
  BUTTON "Cancel" ID 1431 AT (35 140 36 12)
  POPUPLIST ID 1415 1416
END

