// forms.rcp - Db35's converted-from-Constructor forms (1000-2200) + menu bars,
// STATIC and hand-maintained from here on -- same convention as the other
// hand-authored .rcp files in this directory (location35.rcp/todo35alert.rcp/
// aboutdb35.rcp). Make layout adjustments directly in this file.
//
// History: originally emitted at build time by tools/gen_forms.py (since
// removed from the tree), which
// converted the ROM DateBook's Constructor resources and applied a set of
// mechanical transforms (SKIP/REMAP/FORMBOX/NONUSABLE/RELABEL dicts, plus a
// couple of insert-a-new-row text patches for the Location/Title fields --
// see gen_forms.py's own comments for the full reasoning behind each one).
// That script is no longer part of the build; this file is its final output,
// frozen as of the Title-field feature, kept as the base for all further
// manual tweaks (pixel alignment, button repositioning, etc.) -- gen_forms.py
// itself is left in tools/ purely as a historical reference for how each
// object's geometry was originally derived, not as something to re-run.
FORM ID 1000 AT (0 0 160 160)
USABLE
MENUID 1000
BEGIN
  TITLE "................"
  REPEATBUTTON "\x02" ID 1002 AT (59 0 12 13) NOFRAME FONT 4
  PUSHBUTTON "S" ID 1003 AT (72 1 10 12) GROUP 1
  PUSHBUTTON "M" ID 1004 AT (83 1 10 12) GROUP 1
  PUSHBUTTON "T" ID 1005 AT (94 1 10 12) GROUP 1
  PUSHBUTTON "W" ID 1006 AT (105 1 10 12) GROUP 1
  PUSHBUTTON "T" ID 1007 AT (116 1 10 12) GROUP 1
  PUSHBUTTON "F" ID 1008 AT (127 1 10 12) GROUP 1
  PUSHBUTTON "S" ID 1009 AT (138 1 10 12) GROUP 1
  REPEATBUTTON "\x03" ID 1010 AT (149 0 11 13) NOFRAME FONT 4
  PUSHBUTTON "" ID 1011 AT (1 148 9 11) GROUP 2 GRAPHICAL BITMAPID 2000
  PUSHBUTTON "" ID 1012 AT (11 148 9 11) GROUP 2 GRAPHICAL BITMAPID 2001
  PUSHBUTTON "" ID 1013 AT (21 148 9 11) GROUP 2 GRAPHICAL BITMAPID 2002
  PUSHBUTTON "" ID 1014 AT (31 148 9 11) GROUP 2 GRAPHICAL BITMAPID 2003
  BUTTON "New" ID 1015 AT (44 147 22 12)
  BUTTON "Details" ID 1016 AT (70 147 33 12)
  BUTTON "Go to" ID 1017 AT (107 147 27 12)
  REPEATBUTTON "\x01" ID 1018 AT (147 144 13 8) NOFRAME FONT 5
  REPEATBUTTON "\x02" ID 1019 AT (147 152 13 8) NOFRAME FONT 5
  TABLE ID 1020 AT (0 18 160 121) ROWS 11 COLUMNS 3 COLUMNWIDTHS 1 22 136
  GRAFFITISTATEINDICATOR AT (137 150)
END

