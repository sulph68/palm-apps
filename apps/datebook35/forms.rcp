// Db35: Details dialog's own menu bar -- Details became a full-screen form
// that intercepts focus from the Day View (Title-field/tap-to-Details
// feature), so its Record-menu capabilities (Duplicate/Beam) need their own
// way in. Same item IDs as MENU 1000's Record pulldown (105/106) so
// DetailsDoCommand (DateDay.c) shares DuplicateCmd/SendRecordCmd directly.
// Delete Event and Attach/Delete Note are deliberately NOT repeated here --
// Details already has dedicated Delete.../Note buttons for those.
MENU ID 1324
BEGIN
  PULLDOWN "Record"
  BEGIN
    MENUITEM "Duplicate Event" ID 106 "U"
    MENUITEM "Beam Event" ID 105 "B"
  END
  PULLDOWN "Edit"
  BEGIN
    MENUITEM "Undo" ID 10000 "U"
    MENUITEM "Cut" ID 10001 "X"
    MENUITEM "Copy" ID 10002 "C"
    MENUITEM "Paste" ID 10003 "P"
    MENUITEM "Select All" ID 10004 "S"
    MENUITEM SEPARATOR
    MENUITEM "Keyboard" ID 10006 "K"
    MENUITEM "Graffiti Help" ID 10007 "G"
  END
END

