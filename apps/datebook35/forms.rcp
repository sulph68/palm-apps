MENU ID 1000
BEGIN
  PULLDOWN "Record"
  BEGIN
    MENUITEM "New Event" ID 100 "N"
    MENUITEM "Duplicate Event" ID 106 "U"
    MENUITEM "Delete Event..." ID 101 "D"
    MENUITEM "Attach Note" ID 102 "A"
    MENUITEM "Delete Note..." ID 103 "O"
    MENUITEM "Purge..." ID 104 "E"
    MENUITEM SEPARATOR
    MENUITEM "Beam Event" ID 105 "B"
  END
  PULLDOWN "Edit"
  BEGIN
    MENUITEM "Undo" ID 10000 "U"
    MENUITEM "Cut" ID 10001 "X"
    MENUITEM "Copy" ID 10002 "C"
    MENUITEM "Paste" ID 10003 "P"
    MENUITEM "Select All" ID 10004 "S"
    MENUITEM SEPARATOR
    MENUITEM "Keyboard" ID 10006 "K"
    MENUITEM "Graffiti Help" ID 10007 "G"
  END
  PULLDOWN "Options"
  BEGIN
    MENUITEM "Font..." ID 300 "F"
    MENUITEM "Preferences..." ID 301 "R"
    MENUITEM "Display Options..." ID 302 "Y"
    MENUITEM "Phone Lookup" ID 303 "L"
    MENUITEM "CalDAV Sync" ID 306 "C"
    MENUITEM "Security..." ID 304 "H"
    MENUITEM "About Date Book" ID 305
  END
END

