
ICON "icon-big-lr-1.bmp" COMPRESS
BITMAP ID 1001 "card.bmp" COMPRESS


ALERT ID 1000
    DEFAULTBUTTON 0
    ERROR
BEGIN
    TITLE "Bkp1"
    MESSAGE "^1^2^3"
    BUTTONS "OK"
END

ALERT ID 1001
    DEFAULTBUTTON 0
    INFORMATION
BEGIN
    TITLE "Bkp1"
    MESSAGE "^1^2^3"
    BUTTONS "OK" 
END

FORM ID 1000  AT ( 0 0 160 160 )
NOFRAME MENUID 1000 NOSAVEBEHIND
BEGIN
	 TITLE "Bkp1"
        
	LIST  ID 1000  AT (1 17 158 123) VISIBLEITEMS 11
	POPUPTRIGGER "" ID 3000  AT (90 0 70 12) RIGHTANCHOR  
	LIST  ID 3100  AT (79 2 80 46) VISIBLEITEMS 4 DISABLED NONUSABLE
	POPUPLIST ID 3000  3100
	BUTTON "Backup" ID 8000  AT (2 146 36 12)
	BUTTON "Delete" ID 8001    AT (82 146 36 12)
	BUTTON "Restore" ID 8002    AT (122 146 36 12)
END


MENU 1000
BEGIN
     PULLDOWN "Backup"
     BEGIN
          MENUITEM "New" ID 1000 "N"
          MENUITEM "Rename" ID 1003
          MENUITEM "Delete" ID 1001 "D"
          MENUITEM "Restore" ID 1002 "R"
     END
     PULLDOWN "Help"
     BEGIN
          MENUITEM "About..." ID 9000
     END
END

FORM ID 1001  AT ( 2 54 156 104 )
MODAL
BEGIN
        TITLE "XXXXXXXXXXXXX"
	LABEL "File:" AUTOID AT (3 18)
	FIELD ID 1000  AT (24 18 131 13) MAXCHARS 255 NONEDITABLE 
	
	FIELD ID 1001   AT (24 33 131 13) MAXCHARS 255 NONEDITABLE
	LABEL "Size:" AUTOID AT (3 33)
	BUTTON "Cancel" ID 8000  AT (58 90 40 12)
	LABEL "Now:" AUTOID AT (3 48)
	FIELD ID 1002   AT (24 48 131 13) MAXCHARS 255 NONEDITABLE
END

FORM ID 1002  AT ( 2 115 156 43 )
MODAL DEFAULTBTNID 2001
BEGIN
        TITLE "Rename"
	FIELD ID 1000  AT (0 14 156 13) MAXCHARS 128 EDITABLE UNDERLINED
	BUTTON "OK" ID 2000  AT (114 29 40 12)
	BUTTON "Cancel" ID 2001   AT (2 29 40 12)
	GRAFFITISTATEINDICATOR AT (78 30)
END

ALERT ID 1002
    DEFAULTBUTTON 1
    CONFIRMATION
BEGIN
    TITLE "Bkp1"
    MESSAGE "^1^2^3"
    BUTTONS "Restore" "Back"
END

ALERT ID 1003
    DEFAULTBUTTON 2
    CONFIRMATION
BEGIN
    TITLE "Restore"
    MESSAGE "Restore everything in this backup, or choose what to restore?"
    BUTTONS "Everything" "Choose..." "Cancel"
END

FORM ID 1100  AT ( 2 2 156 156 )
MODAL
BEGIN
	TITLE "Choose what to restore"
	LIST  ID 1101  AT (3 15 150 99) VISIBLEITEMS 9
	FIELD ID 1107  AT (3 116 150 12) MAXCHARS 47 NONEDITABLE
	LABEL "Tick:" AUTOID AT (3 129)
	POPUPTRIGGER "Apps and data" ID 1102  AT (26 129 110 12) LEFTANCHOR
	LIST "Everything" "Apps and data" "Data only" "Nothing" ID 1103  AT (28 84 90 44) VISIBLEITEMS 4 NONUSABLE
	POPUPLIST ID 1102  1103
	BUTTON "Restore" ID 1104  AT (4 142 44 12)
	BUTTON "Files..." ID 1105  AT (54 142 44 12)
	BUTTON "Cancel" ID 1106  AT (104 142 44 12)
END

FORM ID 1110  AT ( 2 2 156 156 )
MODAL
BEGIN
	TITLE "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
	LIST  ID 1111  AT (3 15 150 121) VISIBLEITEMS 11
	BUTTON "Done" ID 1112  AT (4 142 44 12)
END

